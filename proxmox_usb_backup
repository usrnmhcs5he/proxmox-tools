# ─────────────────────────────────────────────────────────────────────────────
cat > "${SCRIPTS_DIR}/usb-backup-status" <<'SCRIPTEOF'
#!/bin/bash
# usb-backup-status — Comprehensive status overview
# Usage: usb-backup-status [--smart] [--log[=N]]
set -euo pipefail
SCRIPT_NAME="status"
source /etc/usb-backup/config
source /etc/usb-backup/functions

SHOW_SMART=false
SHOW_LOG=false
LOG_LINES=20

for arg in "$@"; do
    case "$arg" in
        --smart)  SHOW_SMART=true ;;
        --log)    SHOW_LOG=true ;;
        --log=*)  SHOW_LOG=true; LOG_LINES="${arg#--log=}" ;;
        -h|--help)
            echo "Usage: usb-backup-status [--smart] [--log[=N]]"
            exit 0 ;;
    esac
done

echo ""
echo -e "${_C}╔══════════════════════════════════════════════════════════════╗${_N}"
echo -e "${_C}║              USB Storage Status                            ║${_N}"
echo -e "${_C}╚══════════════════════════════════════════════════════════════╝${_N}"
echo ""

# --- Device ---
PART=$(resolve_device 2>/dev/null) || true
DISK=""
if [[ -n "$PART" ]]; then
    DISK=$(resolve_disk "$PART")
    UUID=$(blkid -s UUID -o value "$PART" 2>/dev/null || echo "?")
    echo -e "  Device:     ${_G}CONNECTED${_N}"
    echo "  Partition:  ${PART}  (disk: ${DISK:-?})"
    echo "  UUID:       ${UUID}"
    echo "  Label:      ${LABEL}"
    [[ -n "$DISK" ]] && lsblk -d -o NAME,SIZE,MODEL,SERIAL,TRAN "$DISK" 2>/dev/null | tail -1 | sed 's/^/  Hardware:   /'
else
    echo -e "  Device:     ${_R}NOT CONNECTED${_N} (label '${LABEL}' not found)"
fi
echo ""

# --- Content types ---
echo "  Content:    ${CONTENT_TYPES}"
echo ""

# --- Mount ---
if findmnt -rn "$MOUNTPOINT" &>/dev/null; then
    echo -e "  Mount:      ${_G}MOUNTED${_N} at ${MOUNTPOINT}"

    # Check for read-only (errors=remount-ro)
    if findmnt -rn -o OPTIONS "$MOUNTPOINT" 2>/dev/null | grep -q '\bro\b'; then
        echo -e "  ${_R}⚠  FILESYSTEM IS READ-ONLY — possible disk error!${_N}"
    fi

    df -h "$MOUNTPOINT" | tail -1 | awk '{printf "  Disk:       %s used / %s total (%s free, %s)\n", $3, $2, $4, $5}'

    check_disk_space

    # Per-content-type file counts
    echo ""
    echo "  Content breakdown:"
    IFS=',' read -ra CTYPES <<< "$CONTENT_TYPES"
    for ctype in "${CTYPES[@]}"; do
        local_dir=$(content_dir "$ctype")
        if [[ -n "$local_dir" ]] && [[ -d "${MOUNTPOINT}/${local_dir}" ]]; then
            fcount=$(find "${MOUNTPOINT}/${local_dir}" -maxdepth 1 -type f 2>/dev/null | wc -l)
            dir_size=$(du -sh "${MOUNTPOINT}/${local_dir}" 2>/dev/null | awk '{print $1}')
            printf "    %-22s %4d file(s)  %s  (%s/)\n" "$(content_label "$ctype")" "$fcount" "$dir_size" "$local_dir"
        fi
    done

    # Latest backup (if backup content type is active)
    if has_content_type "backup"; then
        LATEST=$(find "${MOUNTPOINT}/dump" -maxdepth 1 -name "vzdump-*" -type f -printf '%T@ %f\n' 2>/dev/null | sort -rn | head -1 | awk '{print $2}')
        LATEST_DATE=$(find "${MOUNTPOINT}/dump" -maxdepth 1 -name "vzdump-*" -type f -printf '%T@ %Tc\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
        if [[ -n "${LATEST:-}" ]]; then
            echo ""
            echo "  Latest backup: ${LATEST}"
            echo "                 (${LATEST_DATE})"
        fi
    fi

    # Manifest
    if [[ -f "${MOUNTPOINT}/.backup-manifest-latest.txt" ]]; then
        MAN_DATE=$(grep "^# Generated:" "${MOUNTPOINT}/.backup-manifest-latest.txt" | head -1 | sed 's/# Generated: //')
        echo ""
        echo "  Manifest:   ${MAN_DATE}"
    else
        echo ""
        echo -e "  Manifest:   ${_Y}none yet (generated on unmount)${_N}"
    fi
else
    echo -e "  Mount:      ${_Y}NOT MOUNTED${_N}"
fi
echo ""

# --- Proxmox storage ---
if command -v pvesm &>/dev/null; then
    PVE_LINE=$(pvesm status 2>/dev/null | grep "^${STORAGE_ID}" || true)
    if [[ -n "$PVE_LINE" ]]; then
        PVE_STATUS=$(echo "$PVE_LINE" | awk '{print $3}')
        if [[ "$PVE_STATUS" == "active" ]]; then
            echo -e "  Proxmox:    ${_G}${STORAGE_ID} — active${_N}"
        else
            echo -e "  Proxmox:    ${_Y}${STORAGE_ID} — ${PVE_STATUS}${_N}"
        fi
    else
        echo -e "  Proxmox:    ${_R}Storage '${STORAGE_ID}' NOT REGISTERED${_N}"
    fi
fi
echo ""

# --- Archived manifests ---
MAN_COUNT=$(find "$MANIFEST_DIR" -name "manifest-*.txt" -type f 2>/dev/null | wc -l)
if (( MAN_COUNT > 0 )); then
    echo "  Manifests:  ${MAN_COUNT} archived (in ${MANIFEST_DIR})"
    find "$MANIFEST_DIR" -name "manifest-*.txt" -type f -printf '              %f\n' 2>/dev/null | sort | tail -5
    (( MAN_COUNT > 5 )) && echo "              ... and $(( MAN_COUNT - 5 )) more"
    echo ""
fi

# --- SMART ---
if [[ "$SHOW_SMART" == "true" ]] && [[ -n "$DISK" ]]; then
    smart_check "$DISK" || true
elif [[ -n "$DISK" ]] && [[ -f "${CONFIG_DIR}/last-smart-$(basename "$DISK").txt" ]]; then
    SMART_DATE=$(stat -c '%y' "${CONFIG_DIR}/last-smart-$(basename "$DISK").txt" 2>/dev/null | cut -d. -f1)
    echo "  SMART:      last ${SMART_DATE}  (--smart for live check)"
    echo ""
fi

# --- Log ---
if [[ "$SHOW_LOG" == "true" ]] && [[ -f "$LOG_FILE" ]]; then
    echo -e "${_C}  ── Recent log (last ${LOG_LINES}) ────────────────────────────${_N}"
    tail -"${LOG_LINES}" "$LOG_FILE" | sed 's/^/  /'
    echo ""
fi
SCRIPTEOF
chmod +x "${SCRIPTS_DIR}/usb-backup-status"

# ─────────────────────────────────────────────────────────────────────────────
# usb-backup-verify
# ─────────────────────────────────────────────────────────────────────────────
cat > "${SCRIPTS_DIR}/usb-backup-verify" <<'SCRIPTEOF'
#!/bin/bash
# usb-backup-verify — Verify integrity or compare manifests
# Covers all static content types (backup, iso, vztmpl, snippets)
# Usage:
#   usb-backup-verify                     Verify files vs manifest (size check)
#   usb-backup-verify --check             Verify checksums vs manifest (READ-ONLY)
#   usb-backup-verify --regenerate        Regenerate manifest (rewrite)
#   usb-backup-verify --compare <file>    Compare drive manifest vs saved file
#   usb-backup-verify --compare <a> <b>   Compare two manifest files
#   usb-backup-verify --list              List archived manifests
set -euo pipefail
SCRIPT_NAME="verify"
source /etc/usb-backup/config
source /etc/usb-backup/functions

[[ $EUID -ne 0 ]] && { log_err "Run as root."; exit 1; }

MODE="integrity"
FILE_A=""
FILE_B=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --compare)
            MODE="compare"; shift
            [[ $# -ge 1 ]] && FILE_A="$1" && shift
            [[ $# -ge 1 ]] && FILE_B="$1" && shift
            ;;
        --list)        MODE="list"; shift ;;
        --check)       MODE="check"; shift ;;
        --regenerate)  MODE="regenerate"; shift ;;
        --rechecksum)
            # Backwards compat: old name for --check
            MODE="check"; shift ;;
        -h|--help)
            echo "USB Storage Verify — integrity and manifest comparison"
            echo ""
            echo "Covers static content: backups, ISOs, templates, snippets"
            echo "(VM disk images and import staging are excluded — live data)"
            echo ""
            echo "Usage:"
            echo "  usb-backup-verify                     Size + existence check"
            echo "  usb-backup-verify --check             Full checksum verify (READ-ONLY)"
            echo "  usb-backup-verify --regenerate        Rewrite manifest from current files"
            echo "  usb-backup-verify --compare <file>    Drive vs saved manifest"
            echo "  usb-backup-verify --compare <a> <b>   Two manifests"
            echo "  usb-backup-verify --list              List archived manifests"
            exit 0 ;;
        *) log_err "Unknown option: $1"; exit 1 ;;
    esac
done

echo ""

case "$MODE" in
    list)
        log_info "Archived manifests (${MANIFEST_DIR}):"
        echo ""
        if [[ -d "$MANIFEST_DIR" ]] && ls "$MANIFEST_DIR"/manifest-*.txt &>/dev/null 2>&1; then
            find "$MANIFEST_DIR" -name "manifest-*.txt" -type f -printf '  %Tc  %9s bytes  %f\n' | sort
            echo ""
            echo "  Total: $(find "$MANIFEST_DIR" -name "manifest-*.txt" -type f | wc -l) manifest(s)"
        else
            echo "  No archived manifests found."
        fi
        echo ""
        ;;

    compare)
        if [[ -n "$FILE_A" ]] && [[ -n "$FILE_B" ]]; then
            log_info "Comparing two manifest files..."
            compare_manifests "$FILE_A" "$FILE_B"
        elif [[ -n "$FILE_A" ]]; then
            DRIVE_MANIFEST="${MOUNTPOINT}/.backup-manifest-latest.txt"
            if [[ ! -f "$DRIVE_MANIFEST" ]]; then
                log_err "No manifest on drive. Generate first: usb-backup-verify --regenerate"
                exit 1
            fi
            log_info "Comparing drive manifest with: ${FILE_A}"
            compare_manifests "$DRIVE_MANIFEST" "$FILE_A"
        else
            log_err "Provide manifest file(s)."
            echo "  usb-backup-verify --compare <file>"
            echo "  usb-backup-verify --compare <file_a> <file_b>"
            echo ""
            find "$MANIFEST_DIR" -name "manifest-*.txt" -type f -printf '    %f\n' 2>/dev/null | sort | tail -10
            exit 1
        fi
        ;;

    check)
        # READ-ONLY checksum verification against existing manifest.
        # Never rewrites the manifest — detects corruption without blessing it.
        if ! findmnt -rn "$MOUNTPOINT" &>/dev/null; then
            log_err "Drive not mounted."; exit 1
        fi

        MANIFEST="${MOUNTPOINT}/.backup-manifest-latest.txt"
        if [[ ! -f "$MANIFEST" ]]; then
            log_err "No manifest found. Generate one first: usb-backup-verify --regenerate"
            exit 1
        fi

        log_info "Read-only checksum verification against manifest..."
        log_info "(manifest will NOT be rewritten)"
        verify_checksums_readonly "$MANIFEST"
        echo ""
        ;;

    regenerate)
        # Explicitly regenerate the manifest (rewrite from current state)
        if ! findmnt -rn "$MOUNTPOINT" &>/dev/null; then
            log_err "Drive not mounted."; exit 1
        fi

        log_info "Regenerating manifest from current drive content..."
        generate_manifest
        log_ok "Manifest regenerated. Use --check to verify later."
        echo ""
        ;;

    integrity)
        if ! findmnt -rn "$MOUNTPOINT" &>/dev/null; then
            log_err "Drive not mounted."; exit 1
        fi

        MANIFEST="${MOUNTPOINT}/.backup-manifest-latest.txt"
        if [[ ! -f "$MANIFEST" ]]; then
            log_warn "No manifest found. Generate with: usb-backup-verify --regenerate"
            exit 0
        fi

        log_info "Verifying files against manifest (size + existence)..."
        echo ""

        ERRORS=0
        CHECKED=0

        while IFS= read -r line; do
            [[ "$line" == \#* ]] && continue
            [[ -z "$line" ]] && continue

            m_hash=$(echo "$line" | awk '{print $1}')
            m_size=$(echo "$line" | awk '{print $2}')
            m_key=$(echo "$line" | awk '{print $4}')
            [[ -z "$m_key" ]] && continue
            (( CHECKED++ ))

            m_ctype=$(echo "$m_key" | cut -d/ -f1)
            m_fname=$(echo "$m_key" | cut -d/ -f2-)
            m_dir=$(content_dir "$m_ctype")
            fpath="${MOUNTPOINT}/${m_dir}/${m_fname}"

            if [[ ! -f "$fpath" ]]; then
                echo -e "  ${_R}MISSING:  ${m_key}${_N}"
                (( ERRORS++ ))
                continue
            fi

            cur_size=$(stat -c '%s' "$fpath" 2>/dev/null || echo "0")
            if [[ "$cur_size" != "$m_size" ]]; then
                echo -e "  ${_R}SIZE MISMATCH: ${m_key} (manifest: ${m_size}, actual: ${cur_size})${_N}"
                (( ERRORS++ ))
                continue
            fi

            echo -e "  ${_G}✓${_N} ${m_key}  (${cur_size} bytes)"
        done < "$MANIFEST"

        # Files on disk not in manifest (per content type)
        EXTRA=0
        for mctype in $MANIFEST_CONTENT_TYPES; do
            has_content_type "$mctype" || continue
            local_dir=$(content_dir "$mctype")
            pattern=$(content_file_pattern "$mctype")
            [[ ! -d "${MOUNTPOINT}/${local_dir}" ]] && continue
            [[ -z "$pattern" ]] && continue

            while IFS= read -r fpath; do
                [[ -z "$fpath" ]] && continue
                fname=$(basename "$fpath")
                if ! grep -q "  ${mctype}/${fname}$" "$MANIFEST" 2>/dev/null; then
                    echo -e "  ${_Y}NEW: ${mctype}/${fname}${_N}"
                    (( EXTRA++ ))
                fi
            done < <(find "${MOUNTPOINT}/${local_dir}" -maxdepth 1 -type f -name "$pattern" 2>/dev/null)
        done

        echo ""
        if (( ERRORS == 0 )); then
            log_ok "Integrity OK: ${CHECKED} file(s), 0 errors."
        else
            log_err "Integrity FAILED: ${ERRORS} error(s) in ${CHECKED} file(s)!"
        fi
        (( EXTRA > 0 )) && log_info "${EXTRA} new file(s) since last manifest."
        echo ""
        echo "  Full checksum verify (read-only): usb-backup-verify --check"
        echo "  Regenerate manifest:              usb-backup-verify --regenerate"
        echo ""
        ;;
esac
SCRIPTEOF
chmod +x "${SCRIPTS_DIR}/usb-backup-verify"

