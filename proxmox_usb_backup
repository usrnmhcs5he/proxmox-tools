#!/bin/bash
# ==============================================================================
# Proxmox USB SSD Backup Setup
# ==============================================================================
# Version History:
#   v1 - 2026-02-23 - Initial proposal (user draft)
#   v2 - 2026-02-23 - Rewrite: auto-detect, nofail, companion scripts
#   v3 - 2026-02-23 - Full suite: SMART, manifests, LABEL rotation, logging,
#                      pre-format detection, uninstall, shared config/functions
#   v4 - 2026-02-23 - Selectable Proxmox content types: backup, ISO, templates,
#                      disk images, containers, snippets, import. Presets for
#                      common scenarios. Manifest covers all static content.
#                      Updated directory creation, verify, status for multi-role.
#                      Fixes: lsblk-based device resolution (safe for NVMe/mmc),
#                      multi-LABEL collision guard, verify --check (read-only) vs
#                      --regenerate (rewrite), errors=remount-ro for ext4, fuser
#                      instead of lsof, USB-boot safety, smartmontools prompt.
# ==============================================================================
#
# Purpose:  Format a removable USB SSD for use as Proxmox VE storage with
#           user-selected content types (backup, ISO, templates, etc.).
#           Installs a full management suite for safe daily operations.
#
# Usage:    bash /root/setup-usb-backup.sh
# Requires: root, Proxmox VE host
#
# Installed components:
#   /etc/usb-backup/config        - Shared configuration (inc. content types)
#   /etc/usb-backup/functions     - Shared bash functions
#   /etc/usb-backup/manifests/    - Stored manifest copies
#   /usr/local/sbin/usb-backup-mount     - Mount + enable + SMART health check
#   /usr/local/sbin/usb-backup-unmount   - Manifest + disable + unmount + eject
#   /usr/local/sbin/usb-backup-status    - Device/mount/storage/health overview
#   /usr/local/sbin/usb-backup-verify    - Integrity check + manifest comparison
#   /usr/local/sbin/usb-backup-uninstall - Clean removal of all components
#   /var/log/usb-backup.log              - Operation log
#
# Drive rotation:
#   Uses LABEL= in fstab so any ext4 disk labeled 'pve-backup' will mount
#   to the same mountpoint. Label all rotation drives identically during setup.
#
# Content types & Proxmox directory layout:
#   backup  → dump/            VZDump backup files
#   iso     → template/iso/    ISO images
#   vztmpl  → template/cache/  Container templates
#   images  → images/          VM disk images (qcow2, raw, vmdk)
#   rootdir → images/          Container root directories
#   snippets→ snippets/        Hook scripts, cloud-init configs
#   import  → import/          Import staging area
# ==============================================================================

set -euo pipefail

# ══════════════════════════════════════════════════════════════════════════════
# CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
MOUNTPOINT="/mnt/usb-backup"
STORAGE_ID="usb-backup"
LABEL="pve-backup"
CONFIG_DIR="/etc/usb-backup"
MANIFEST_DIR="${CONFIG_DIR}/manifests"
LOG_FILE="/var/log/usb-backup.log"
SCRIPTS_DIR="/usr/local/sbin"

MIN_SIZE_BYTES=50000000000      # ~50 GB
MAX_SIZE_BYTES=4400000000000    # ~4 TB

SMART_WEAR_WARN=80
SMART_REALLOC_WARN=10
SMART_TEMP_WARN=65

DISK_WARN_PCT=80
DISK_CRIT_PCT=90

# ══════════════════════════════════════════════════════════════════════════════
# TERMINAL HELPERS
# ══════════════════════════════════════════════════════════════════════════════
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

_log_file() {
    local level="$1"; shift
    echo "$(date '+%Y-%m-%d %H:%M:%S') [${level}] (setup) $*" >> "$LOG_FILE" 2>/dev/null || true
}
msg()  { echo -e "${GREEN}[OK]${NC}    $1"; _log_file "OK" "$1"; }
warn() { echo -e "${YELLOW}[WARN]${NC}  $1"; _log_file "WARN" "$1"; }
err()  { echo -e "${RED}[ERROR]${NC} $1" >&2; _log_file "ERROR" "$1"; }
info() { echo -e "${CYAN}[INFO]${NC}  $1"; _log_file "INFO" "$1"; }
die()  { err "$1"; exit 1; }

# ══════════════════════════════════════════════════════════════════════════════
# PRE-FLIGHT CHECKS
# ══════════════════════════════════════════════════════════════════════════════
[[ $EUID -ne 0 ]] && die "This script must be run as root."
command -v pvesm &>/dev/null || die "pvesm not found — this script requires a Proxmox VE host."

mkdir -p "$(dirname "$LOG_FILE")"
touch "$LOG_FILE"

if ! command -v smartctl &>/dev/null; then
    echo ""
    echo -e "${YELLOW}[WARN]${NC}  smartmontools is not installed (needed for SSD health monitoring)."
    read -rp "  Install smartmontools now? [Y/n]: " INSTALL_SMART
    if [[ "$INSTALL_SMART" != "n" && "$INSTALL_SMART" != "N" ]]; then
        apt-get update -qq && apt-get install -y -qq smartmontools 2>/dev/null || true
        if command -v smartctl &>/dev/null; then
            msg "smartmontools installed successfully."
        else
            warn "Could not install smartmontools. SMART health checks will be unavailable."
        fi
    else
        warn "Skipping smartmontools. SMART health checks will be unavailable."
    fi
fi

# ══════════════════════════════════════════════════════════════════════════════
# DEVICE SELECTION
# ══════════════════════════════════════════════════════════════════════════════
echo ""
echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║          Proxmox USB Storage Setup  (v4)                   ║${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"
echo ""
info "Scanning for removable USB/SATA storage devices..."
echo ""
echo "  All block devices:"
echo "  ─────────────────────────────────────────────────────────────"
lsblk -d -o NAME,SIZE,MODEL,TRAN,RM,TYPE | grep -E "disk|NAME" | sed 's/^/  /'
echo "  ─────────────────────────────────────────────────────────────"
echo ""

# Boot disk detection — robust for ZFS/LVM/MD where findmnt may not resolve cleanly
BOOT_DISK=""
_boot_source=$(findmnt -no SOURCE / 2>/dev/null | head -1)
if [[ -n "$_boot_source" ]]; then
    # Try lsblk parent first (works for partitions, LVM, device-mapper)
    BOOT_DISK=$(lsblk -ndo PKNAME "$_boot_source" 2>/dev/null | head -1)
    # Fallback: for ZFS root, check /boot or /boot/efi which are usually on a partition
    if [[ -z "$BOOT_DISK" ]]; then
        _boot_efi=$(findmnt -no SOURCE /boot/efi 2>/dev/null || findmnt -no SOURCE /boot 2>/dev/null || true)
        [[ -n "$_boot_efi" ]] && BOOT_DISK=$(lsblk -ndo PKNAME "$_boot_efi" 2>/dev/null | head -1)
    fi
fi

declare -a CANDIDATES=()
while IFS= read -r devpath; do
    DEV_NAME=$(basename "$devpath")
    [[ "$DEV_NAME" == "$BOOT_DISK" ]] && continue
    CANDIDATES+=("$devpath")
done < <(lsblk -dnpo NAME,TRAN,RM,TYPE | awk '$4=="disk" && ($2=="usb" || $3==1) {print $1}')

if [[ ${#CANDIDATES[@]} -eq 0 ]]; then
    warn "No removable USB storage detected automatically."
    echo "  You can manually enter a device path (e.g., /dev/sdb)."
    echo ""
    read -rp "  Enter device path (or Enter to abort): " DEVICE
    [[ -z "$DEVICE" ]] && die "Aborted — no device selected."
    [[ ! -b "$DEVICE" ]] && die "$DEVICE is not a valid block device."
elif [[ ${#CANDIDATES[@]} -eq 1 ]]; then
    DEVICE="${CANDIDATES[0]}"
    info "Found one removable device: $DEVICE"
else
    info "Found multiple removable devices:"
    for i in "${!CANDIDATES[@]}"; do
        DEV="${CANDIDATES[$i]}"
        DEV_INFO=$(lsblk -dno SIZE,MODEL "$DEV" 2>/dev/null | xargs)
        echo "    [$((i+1))] $DEV  ($DEV_INFO)"
    done
    echo ""
    read -rp "  Select device number [1-${#CANDIDATES[@]}]: " CHOICE
    if [[ "$CHOICE" =~ ^[0-9]+$ ]] && (( CHOICE >= 1 && CHOICE <= ${#CANDIDATES[@]} )); then
        DEVICE="${CANDIDATES[$((CHOICE-1))]}"
    else
        die "Invalid selection."
    fi
fi

# ── Normalize to parent disk using lsblk (safe for NVMe/mmc/sd naming) ──
[[ "$DEVICE" != /dev/* ]] && DEVICE="/dev/$DEVICE"
if lsblk -no TYPE "$DEVICE" 2>/dev/null | grep -qx "part"; then
    _parent=$(lsblk -ndo PKNAME "$DEVICE" 2>/dev/null | head -1)
    [[ -n "$_parent" ]] && DEVICE="/dev/$_parent"
fi
# Verify it's actually a disk
if ! lsblk -no TYPE "$DEVICE" 2>/dev/null | grep -qx "disk"; then
    die "$DEVICE does not appear to be a whole disk device."
fi
info "Selected device: $DEVICE"

# ── Safety: refuse to wipe a non-USB device without explicit confirmation ──
DEVICE_TRAN=$(lsblk -ndo TRAN "$DEVICE" 2>/dev/null | head -1)
if [[ "$DEVICE_TRAN" != "usb" ]]; then
    echo ""
    warn "Device ${DEVICE} transport is '${DEVICE_TRAN:-unknown}' (not USB)."
    echo "  This is unusual for removable backup storage."
    read -rp "  Are you SURE this is the correct device? [y/N]: " NONUSB_CONFIRM
    [[ "$NONUSB_CONFIRM" != "y" && "$NONUSB_CONFIRM" != "Y" ]] && die "Aborted — non-USB device not confirmed."
fi

# ── Safety: refuse if selected device is the boot disk ──
if [[ -n "$BOOT_DISK" ]] && [[ "$(basename "$DEVICE")" == "$BOOT_DISK" ]]; then
    die "REFUSING: ${DEVICE} appears to be the boot disk!"
fi

# ══════════════════════════════════════════════════════════════════════════════
# SAFETY: SIZE CHECK
# ══════════════════════════════════════════════════════════════════════════════
SIZE=$(blockdev --getsize64 "$DEVICE" 2>/dev/null || echo 0)
SIZE_GB=$(( SIZE / 1073741824 ))

if [[ "$SIZE" -lt "$MIN_SIZE_BYTES" ]] || [[ "$SIZE" -gt "$MAX_SIZE_BYTES" ]]; then
    err "Device size ${SIZE_GB} GB outside expected range ($(( MIN_SIZE_BYTES/1073741824 ))-$(( MAX_SIZE_BYTES/1073741824 )) GB)."
    die "Adjust MIN_SIZE_BYTES/MAX_SIZE_BYTES at top of script if this is intentional."
fi

# ══════════════════════════════════════════════════════════════════════════════
# CONTENT TYPE SELECTION
# ══════════════════════════════════════════════════════════════════════════════
echo ""
echo -e "${CYAN}  ┌── Storage Content Types ────────────────────────────────────┐${NC}"
echo "  │                                                              │"
echo "  │  Select what this USB storage will be used for.              │"
echo "  │  Each drive can serve a different purpose.                   │"
echo "  │                                                              │"
echo "  │  Available content types:                                    │"
echo "  │    backup   - VZDump backup files          (dump/)           │"
echo "  │    iso      - ISO images                   (template/iso/)   │"
echo "  │    vztmpl   - Container templates          (template/cache/) │"
echo "  │    images   - VM disk images (qcow2/raw)   (images/)         │"
echo "  │    rootdir  - Container root directories   (images/)         │"
echo "  │    snippets - Hook scripts, cloud-init     (snippets/)       │"
echo "  │    import   - Import staging area           (import/)         │"
echo "  │                                                              │"
echo -e "  └────────────────────────────────────────────────────────────────┘${NC}"
echo ""
echo "  Choose a preset or build your own combination:"
echo ""
echo "    [1] Backup only"
echo "        → backup"
echo ""
echo "    [2] Backup + ISO storage"
echo "        → backup, iso"
echo ""
echo "    [3] Backup + ISO + Templates"
echo "        → backup, iso, vztmpl"
echo ""
echo "    [4] Portable node storage (backup + restore/import + ISO)"
echo "        → backup, iso, vztmpl, images, import"
echo ""
echo "    [5] Everything (all content types)"
echo "        → backup, iso, vztmpl, images, rootdir, snippets, import"
echo ""
echo "    [6] Custom (pick individually)"
echo ""

read -rp "  Select preset [1-6]: " PRESET_CHOICE

case "$PRESET_CHOICE" in
    1) CONTENT_TYPES="backup" ;;
    2) CONTENT_TYPES="backup,iso" ;;
    3) CONTENT_TYPES="backup,iso,vztmpl" ;;
    4) CONTENT_TYPES="backup,iso,vztmpl,images,import" ;;
    5) CONTENT_TYPES="backup,iso,vztmpl,images,rootdir,snippets,import" ;;
    6)
        echo ""
        echo "  Toggle each content type (y/n):"
        echo ""
        CONTENT_TYPES=""

        for ctype in backup iso vztmpl images rootdir snippets import; do
            case "$ctype" in
                backup)   desc="VZDump backup files" ;;
                iso)      desc="ISO images" ;;
                vztmpl)   desc="Container templates" ;;
                images)   desc="VM disk images (qcow2, raw, vmdk)" ;;
                rootdir)  desc="Container root directories" ;;
                snippets) desc="Hook scripts, cloud-init configs" ;;
                import)   desc="Import staging area" ;;
            esac

            read -rp "    Include ${ctype} (${desc})? [y/N]: " yn
            if [[ "$yn" == "y" || "$yn" == "Y" ]]; then
                [[ -n "$CONTENT_TYPES" ]] && CONTENT_TYPES="${CONTENT_TYPES},"
                CONTENT_TYPES="${CONTENT_TYPES}${ctype}"
            fi
        done

        if [[ -z "$CONTENT_TYPES" ]]; then
            warn "No content types selected. Defaulting to 'backup'."
            CONTENT_TYPES="backup"
        fi
        ;;
    *)
        die "Invalid selection."
        ;;
esac

echo ""
info "Selected content types: ${CONTENT_TYPES}"
echo ""

# ══════════════════════════════════════════════════════════════════════════════
# PRE-FORMAT DETECTION
# ══════════════════════════════════════════════════════════════════════════════
SKIP_FORMAT=false

# Search by label first, then confirm it lives on the selected device
EXISTING_PART=""
LABEL_MATCHES=$(blkid -o device -t LABEL="$LABEL" 2>/dev/null || true)
if [[ -n "$LABEL_MATCHES" ]]; then
    # Check which (if any) of the matches belong to the selected device
    while IFS= read -r match_part; do
        [[ -z "$match_part" ]] && continue
        match_parent=$(lsblk -ndo PKNAME "$match_part" 2>/dev/null | head -1)
        if [[ "/dev/$match_parent" == "$DEVICE" ]]; then
            EXISTING_PART="$match_part"
            break
        fi
    done <<< "$LABEL_MATCHES"
fi

if [[ -n "$EXISTING_PART" ]]; then
    EXISTING_LABEL=$(blkid -s LABEL -o value "$EXISTING_PART" 2>/dev/null || true)
    EXISTING_FS=$(blkid -s TYPE -o value "$EXISTING_PART" 2>/dev/null || true)
    EXISTING_UUID=$(blkid -s UUID -o value "$EXISTING_PART" 2>/dev/null || true)

    if [[ "$EXISTING_LABEL" == "$LABEL" ]] && [[ "$EXISTING_FS" == "ext4" ]]; then
        echo ""
        echo -e "${GREEN}  ┌─────────────────────────────────────────────────────────┐${NC}"
        echo -e "${GREEN}  │  EXISTING SETUP DETECTED                                │${NC}"
        echo -e "${GREEN}  │  Label: ${EXISTING_LABEL}  FS: ${EXISTING_FS}  UUID: ${EXISTING_UUID:0:8}...  │${NC}"
        echo -e "${GREEN}  └─────────────────────────────────────────────────────────┘${NC}"
        echo ""
        echo "  This device already has an ext4 filesystem labeled '$LABEL'."
        echo "  You can re-register with new content types without formatting."
        echo ""
        echo "    [1] Re-register only (keep data, apply new content types)"
        echo "    [2] Full format (ERASE ALL DATA)"
        echo "    [3] Abort"
        echo ""
        read -rp "  Choose [1/2/3]: " REUSE_CHOICE
        case "$REUSE_CHOICE" in
            1)
                SKIP_FORMAT=true
                info "Skipping format — will re-register with content: ${CONTENT_TYPES}"
                ;;
            2) info "Full format selected." ;;
            *) die "Aborted." ;;
        esac
    fi
fi

# ══════════════════════════════════════════════════════════════════════════════
# DESTRUCTIVE OPERATIONS
# ══════════════════════════════════════════════════════════════════════════════
if [[ "$SKIP_FORMAT" == "false" ]]; then
    echo ""
    echo -e "${RED}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}║                    CRITICAL WARNING                        ║${NC}"
    echo -e "${RED}║       This will ERASE ALL DATA on ${DEVICE}               ║${NC}"
    echo -e "${RED}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo "  Device:  $DEVICE"
    echo "  Size:    ${SIZE_GB} GB"
    echo "  Content: ${CONTENT_TYPES}"
    lsblk -d -o NAME,SIZE,MODEL,SERIAL,TRAN "$DEVICE" 2>/dev/null | sed 's/^/  /'
    echo ""
    echo "  Current content:"
    lsblk -f "$DEVICE" 2>/dev/null | sed 's/^/    /' || true
    echo ""

    read -rp "  Type YES to continue: " CONFIRM1
    [[ "$CONFIRM1" != "YES" ]] && die "Aborted by user."
    read -rp "  Type DESTROY to confirm data destruction: " CONFIRM2
    [[ "$CONFIRM2" != "DESTROY" ]] && die "Aborted by user."

    info "Unmounting any existing partitions on ${DEVICE}..."
    for part in "${DEVICE}"*; do
        [[ "$part" == "$DEVICE" ]] && continue
        findmnt -rn "$part" &>/dev/null && umount "$part" 2>/dev/null || true
    done
    findmnt -rn "$DEVICE" &>/dev/null && umount "$DEVICE" 2>/dev/null || true
    msg "Partitions unmounted."

    info "Wiping all filesystem signatures and partition table..."
    wipefs --all --force "$DEVICE" 2>/dev/null || true
    dd if=/dev/zero of="$DEVICE" bs=1M count=10 status=none 2>/dev/null || true
    msg "Device wiped."

    info "Creating GPT partition table + ext4 partition..."
    parted -s "$DEVICE" mklabel gpt
    parted -s "$DEVICE" mkpart primary ext4 1MiB 100%
    sleep 2
    partprobe "$DEVICE" 2>/dev/null || true
    sleep 2

    PART=""
    for candidate in "${DEVICE}1" "${DEVICE}p1"; do
        [[ -b "$candidate" ]] && PART="$candidate" && break
    done
    if [[ -z "$PART" ]]; then
        sleep 3; partprobe "$DEVICE" 2>/dev/null || true; sleep 2
        for candidate in "${DEVICE}1" "${DEVICE}p1"; do
            [[ -b "$candidate" ]] && PART="$candidate" && break
        done
        [[ -z "$PART" ]] && die "Partition not found after partitioning ${DEVICE}."
    fi
    msg "Partition created: $PART"

    info "Formatting as ext4 with label '${LABEL}'..."
    mkfs.ext4 -F -L "$LABEL" "$PART"
    msg "Formatted."
else
    PART="$EXISTING_PART"
fi

UUID=$(blkid -s UUID -o value "$PART")
[[ -z "$UUID" ]] && die "Failed to read UUID from $PART."
info "Partition: $PART  UUID: $UUID  Label: $LABEL"

# ══════════════════════════════════════════════════════════════════════════════
# FSTAB CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
info "Configuring mount point and fstab..."

mkdir -p "$MOUNTPOINT"

FSTAB_BACKUP="/etc/fstab.pre-usb-backup-$(date +%Y%m%d-%H%M%S)"
cp /etc/fstab "$FSTAB_BACKUP"
msg "fstab backed up to $FSTAB_BACKUP"

sed -i '/# USB backup SSD (pve-backup)/d' /etc/fstab
sed -i "\|${MOUNTPOINT}|d" /etc/fstab

# errors=remount-ro: on filesystem error, go read-only to prevent further damage
# (scripts detect ro state and fail loudly rather than writing into corruption)
FSTAB_OPTS="noauto,nofail,noatime,x-systemd.automount,x-systemd.device-timeout=5,x-systemd.idle-timeout=0,errors=remount-ro"
{
    echo "# USB backup SSD (pve-backup) — managed by usb-backup-setup ($(date +%Y-%m-%d))"
    echo "LABEL=${LABEL}  ${MOUNTPOINT}  ext4  ${FSTAB_OPTS}  0  2"
} >> /etc/fstab

systemctl daemon-reload
msg "fstab updated (LABEL-based, errors=remount-ro) and systemd reloaded."

# ══════════════════════════════════════════════════════════════════════════════
# MOUNT AND CREATE DIRECTORY STRUCTURE FOR SELECTED CONTENT TYPES
# ══════════════════════════════════════════════════════════════════════════════
info "Mounting and preparing directory structure..."

findmnt -rn "$MOUNTPOINT" &>/dev/null && umount "$MOUNTPOINT" 2>/dev/null || true
mount "$MOUNTPOINT"

# Create Proxmox-expected subdirectories based on selected content types
# Proxmox layout: https://pve.proxmox.com/wiki/Storage:_Directory
IFS=',' read -ra CTYPES <<< "$CONTENT_TYPES"
for ctype in "${CTYPES[@]}"; do
    case "$ctype" in
        backup)   mkdir -p "${MOUNTPOINT}/dump" ;;
        iso)      mkdir -p "${MOUNTPOINT}/template/iso" ;;
        vztmpl)   mkdir -p "${MOUNTPOINT}/template/cache" ;;
        images)   mkdir -p "${MOUNTPOINT}/images" ;;
        rootdir)  mkdir -p "${MOUNTPOINT}/images" ;;
        snippets) mkdir -p "${MOUNTPOINT}/snippets" ;;
        import)   mkdir -p "${MOUNTPOINT}/import" ;;
    esac
    msg "  Created directory for: ${ctype}"
done

chown -R root:root "${MOUNTPOINT}/"
chmod 755 "${MOUNTPOINT}/"

# Disk identity marker
cat > "${MOUNTPOINT}/.backup-disk-info" <<EOF
label=${LABEL}
uuid=${UUID}
device=${DEVICE}
partition=${PART}
content_types=${CONTENT_TYPES}
created=$(date -Iseconds)
setup_version=4
purpose=Proxmox VE USB storage
EOF

msg "Mounted at $MOUNTPOINT — directories ready."

# ══════════════════════════════════════════════════════════════════════════════
# REGISTER IN PROXMOX VE
# ══════════════════════════════════════════════════════════════════════════════
info "Registering storage in Proxmox..."

if pvesm status 2>/dev/null | grep -q "^${STORAGE_ID}"; then
    warn "Storage '${STORAGE_ID}' exists — removing and re-adding..."
    pvesm remove "$STORAGE_ID" 2>/dev/null || true
fi

pvesm add dir "$STORAGE_ID" \
    --path "$MOUNTPOINT" \
    --content "$CONTENT_TYPES" \
    --is_mountpoint 1

msg "Proxmox storage '${STORAGE_ID}' registered with content: ${CONTENT_TYPES}"

# ══════════════════════════════════════════════════════════════════════════════
# INSTALL SHARED CONFIG AND FUNCTIONS
# ══════════════════════════════════════════════════════════════════════════════
info "Installing configuration and shared functions..."

mkdir -p "$CONFIG_DIR" "$MANIFEST_DIR"

# ── /etc/usb-backup/config ──────────────────────────────────────────────────
cat > "${CONFIG_DIR}/config" <<CFGEOF
# USB Backup configuration — generated by setup-usb-backup.sh v4
# $(date -Iseconds)

MOUNTPOINT="${MOUNTPOINT}"
STORAGE_ID="${STORAGE_ID}"
LABEL="${LABEL}"
CONFIG_DIR="${CONFIG_DIR}"
MANIFEST_DIR="${MANIFEST_DIR}"
LOG_FILE="${LOG_FILE}"
CONTENT_TYPES="${CONTENT_TYPES}"

# SMART thresholds
SMART_WEAR_WARN=${SMART_WEAR_WARN}
SMART_REALLOC_WARN=${SMART_REALLOC_WARN}
SMART_TEMP_WARN=${SMART_TEMP_WARN}

# Disk space thresholds (percent used)
DISK_WARN_PCT=${DISK_WARN_PCT}
DISK_CRIT_PCT=${DISK_CRIT_PCT}
CFGEOF

# ── /etc/usb-backup/functions ───────────────────────────────────────────────
cat > "${CONFIG_DIR}/functions" <<'FUNCEOF'
# USB Backup shared functions — sourced by all companion scripts
# shellcheck shell=bash

# --- Terminal colors ---
if [[ -t 1 ]]; then
    _R='\033[0;31m'; _G='\033[0;32m'; _Y='\033[1;33m'
    _C='\033[0;36m'; _B='\033[1m'; _N='\033[0m'
else
    _R=''; _G=''; _Y=''; _C=''; _B=''; _N=''
fi

# --- Logging ---
_log() {
    local level="$1" caller="$2"; shift 2
    echo "$(date '+%Y-%m-%d %H:%M:%S') [${level}] (${caller}) $*" >> "$LOG_FILE" 2>/dev/null || true
}
log_ok()   { echo -e "${_G}[OK]${_N}    $1"; _log "OK" "${SCRIPT_NAME:-unknown}" "$1"; }
log_warn() { echo -e "${_Y}[WARN]${_N}  $1"; _log "WARN" "${SCRIPT_NAME:-unknown}" "$1"; }
log_err()  { echo -e "${_R}[ERROR]${_N} $1" >&2; _log "ERROR" "${SCRIPT_NAME:-unknown}" "$1"; }
log_info() { echo -e "${_C}[INFO]${_N}  $1"; _log "INFO" "${SCRIPT_NAME:-unknown}" "$1"; }

# --- Device resolution (with multi-label collision guard) ---
resolve_device() {
    local matches match_count
    matches=$(blkid -o device -t LABEL="$LABEL" 2>/dev/null || true)
    if [[ -z "$matches" ]]; then
        return 0  # No device found, empty output
    fi
    match_count=$(echo "$matches" | grep -c . 2>/dev/null || echo 0)
    if (( match_count > 1 )); then
        log_err "COLLISION: ${match_count} drives with LABEL=${LABEL} connected!"
        log_err "Devices: $(echo "$matches" | tr '\n' ' ')"
        log_err "Unplug extra drives and retry."
        echo ""  # Return empty to signal error
        return 1
    fi
    echo "$matches"
}

resolve_disk() {
    local part="$1" disk
    disk=$(lsblk -ndo PKNAME "$part" 2>/dev/null | head -1)
    [[ -n "$disk" ]] && echo "/dev/$disk" || echo ""
}

# --- Content type helpers ---
has_content_type() {
    echo ",$CONTENT_TYPES," | grep -q ",$1,"
}

# Map content type → directory path (relative to MOUNTPOINT)
content_dir() {
    case "$1" in
        backup)   echo "dump" ;;
        iso)      echo "template/iso" ;;
        vztmpl)   echo "template/cache" ;;
        images)   echo "images" ;;
        rootdir)  echo "images" ;;
        snippets) echo "snippets" ;;
        import)   echo "import" ;;
        *)        echo "" ;;
    esac
}

# Human-readable content type label
content_label() {
    case "$1" in
        backup)   echo "VZDump backups" ;;
        iso)      echo "ISO images" ;;
        vztmpl)   echo "Container templates" ;;
        images)   echo "VM disk images" ;;
        rootdir)  echo "Container root dirs" ;;
        snippets) echo "Snippets" ;;
        import)   echo "Import staging" ;;
        *)        echo "$1" ;;
    esac
}

# Content types with static files suitable for checksumming.
# images and import excluded: images change constantly, import is transient.
MANIFEST_CONTENT_TYPES="backup iso vztmpl snippets"

# File pattern per content type for manifest (what to checksum)
content_file_pattern() {
    case "$1" in
        backup)   echo "vzdump-*" ;;
        iso)      echo "*.iso" ;;
        vztmpl)   echo "*.tar.*" ;;
        snippets) echo "*" ;;
        *)        echo "" ;;
    esac
}

# --- Read-only mount check (detect errors=remount-ro trigger) ---
check_ro_mount() {
    if findmnt -rn -o OPTIONS "$MOUNTPOINT" 2>/dev/null | grep -q '\bro\b'; then
        log_err "Filesystem is mounted READ-ONLY! Possible disk/filesystem error."
        log_err "Run: dmesg | tail -30  and  fsck.ext4 -n ${MOUNTPOINT}"
        return 1
    fi
    return 0
}

# --- SMART health check ---
smart_check() {
    local disk="$1"
    local rc=0

    if ! command -v smartctl &>/dev/null; then
        log_warn "SMART: smartctl not installed — skipping health check."
        return 2
    fi

    local smart_output="" smart_rc=1
    for dtype in sat auto ""; do
        local flag=""
        [[ -n "$dtype" ]] && flag="-d $dtype"
        # shellcheck disable=SC2086
        if smart_output=$(smartctl -a $flag "$disk" 2>&1); then
            smart_rc=0
            break
        fi
        smart_rc=$?
    done

    if [[ $smart_rc -ne 0 ]] && ! echo "$smart_output" | grep -qi "SMART"; then
        log_warn "SMART: Could not read data from $disk (USB enclosure may block passthrough)."
        return 2
    fi

    echo ""
    echo -e "${_C}  ┌── SMART Health Summary ─────────────────────────────────┐${_N}"

    # Overall health
    local health
    health=$(echo "$smart_output" | grep -i "SMART overall-health" | awk -F': ' '{print $2}' | xargs)
    if [[ -n "$health" ]]; then
        if [[ "$health" != "PASSED" ]]; then
            echo -e "  │ ${_R}Overall:              ${health}${_N}"
            rc=1
        else
            echo -e "  │ ${_G}Overall:              PASSED${_N}"
        fi
    fi

    # Temperature
    local temp=""
    temp=$(echo "$smart_output" | grep -E "^194 " | awk '{print $10}' | head -1)
    [[ -z "$temp" ]] && temp=$(echo "$smart_output" | grep -i "^Temperature:" | head -1 | grep -oP '\d+' | head -1)
    if [[ -n "$temp" ]] && [[ "$temp" =~ ^[0-9]+$ ]]; then
        if (( temp > SMART_TEMP_WARN )); then
            echo -e "  │ ${_R}Temperature:          ${temp}°C (threshold: ${SMART_TEMP_WARN}°C)${_N}"
            rc=1
        else
            echo -e "  │ ${_G}Temperature:          ${temp}°C${_N}"
        fi
    fi

    # Reallocated sectors (attr 5)
    local realloc=""
    realloc=$(echo "$smart_output" | grep -E "^  5 " | awk '{print $10}')
    if [[ -n "$realloc" ]] && [[ "$realloc" =~ ^[0-9]+$ ]]; then
        if (( realloc > SMART_REALLOC_WARN )); then
            echo -e "  │ ${_R}Reallocated sectors:  ${realloc} (threshold: ${SMART_REALLOC_WARN})${_N}"
            rc=1
        else
            echo -e "  │ ${_G}Reallocated sectors:  ${realloc}${_N}"
        fi
    fi

    # Pending sectors (attr 197)
    local pending=""
    pending=$(echo "$smart_output" | grep -E "^197 " | awk '{print $10}')
    if [[ -n "$pending" ]] && [[ "$pending" =~ ^[0-9]+$ ]] && (( pending > 0 )); then
        echo -e "  │ ${_R}Pending sectors:      ${pending}${_N}"
        rc=1
    fi

    # Wear: NVMe Percentage Used (0% = new, increases toward 100%+)
    local wear_shown=false
    local nvme_pct=""
    nvme_pct=$(echo "$smart_output" | grep -i "Percentage Used" | grep -oP '\d+' | head -1)
    if [[ -n "$nvme_pct" ]] && [[ "$nvme_pct" =~ ^[0-9]+$ ]]; then
        if (( nvme_pct > SMART_WEAR_WARN )); then
            echo -e "  │ ${_R}SSD wear (NVMe):      ${nvme_pct}% used (threshold: ${SMART_WEAR_WARN}%)${_N}"
            rc=1
        else
            echo -e "  │ ${_G}SSD wear (NVMe):      ${nvme_pct}% used${_N}"
        fi
        wear_shown=true
    fi

    # Wear: SATA Wear_Leveling_Count / Media_Wearout_Indicator
    # Normalized VALUE starts at 100 (new) and decreases toward 0 (end of life).
    # We compute wear_used = 100 - VALUE, so wear_used=0 is new, 100 is depleted.
    if [[ "$wear_shown" == "false" ]]; then
        local wear_val=""
        wear_val=$(echo "$smart_output" | grep -iE "Wear_Leveling_Count|Media_Wearout_Indicator" | awk '{print $4}' | head -1)
        if [[ -n "$wear_val" ]] && [[ "$wear_val" =~ ^[0-9]+$ ]]; then
            local wear_used=$(( 100 - wear_val ))
            if (( wear_used > SMART_WEAR_WARN )); then
                echo -e "  │ ${_R}SSD wear (SATA):      ~${wear_used}% used (normalized: ${wear_val}/100)${_N}"
                rc=1
            else
                echo -e "  │ ${_G}SSD wear (SATA):      ~${wear_used}% used (normalized: ${wear_val}/100)${_N}"
            fi
            wear_shown=true
        fi
    fi

    # SSD Life Remaining (attr 231) — normalized VALUE (100=new, decreases)
    if [[ "$wear_shown" == "false" ]]; then
        local life_val=""
        life_val=$(echo "$smart_output" | grep -i "SSD_Life_Remaining\|Life_Remaining" | awk '{print $4}' | head -1)
        if [[ -n "$life_val" ]] && [[ "$life_val" =~ ^[0-9]+$ ]]; then
            echo -e "  │ ${_G}SSD life remaining:   ${life_val}%${_N}"
        fi
    fi

    # Power-on hours
    local poh=""
    poh=$(echo "$smart_output" | grep -E "^  9 " | awk '{print $10}' | head -1)
    [[ -z "$poh" ]] && poh=$(echo "$smart_output" | grep -i "Power On Hours" | grep -oP '[\d,]+' | head -1 | tr -d ',')
    [[ -n "$poh" ]] && echo "  │ Power-on hours:      ${poh}"

    # Power cycles
    local pcc=""
    pcc=$(echo "$smart_output" | grep -E "^ 12 " | awk '{print $10}' | head -1)
    [[ -z "$pcc" ]] && pcc=$(echo "$smart_output" | grep -i "Power Cycles" | grep -oP '[\d,]+' | head -1 | tr -d ',')
    [[ -n "$pcc" ]] && echo "  │ Power cycles:        ${pcc}"

    # Unexpected power loss
    local upl=""
    upl=$(echo "$smart_output" | grep -E "^174 " | awk '{print $10}')
    [[ -z "$upl" ]] && upl=$(echo "$smart_output" | grep -i "Unsafe Shutdowns" | grep -oP '[\d,]+' | head -1 | tr -d ',')
    if [[ -n "$upl" ]] && [[ "$upl" =~ ^[0-9]+$ ]] && (( upl > 0 )); then
        echo -e "  │ ${_Y}Unexpected power off: ${upl}${_N}"
    fi

    # CRC errors (attr 199)
    local crc=""
    crc=$(echo "$smart_output" | grep -E "^199 " | awk '{print $10}')
    if [[ -n "$crc" ]] && [[ "$crc" =~ ^[0-9]+$ ]] && (( crc > 0 )); then
        echo -e "  │ ${_Y}UDMA CRC errors:     ${crc} (cable issue?)${_N}"
    fi

    echo -e "${_C}  └──────────────────────────────────────────────────────────┘${_N}"

    if [[ $rc -eq 1 ]]; then
        _log "WARN" "${SCRIPT_NAME:-smart}" "Health warnings on $disk"
        echo ""
        echo -e "  ${_R}${_B}⚠  SMART warnings detected! Consider replacing this drive.${_N}"
    fi
    echo ""

    echo "$smart_output" > "${CONFIG_DIR}/last-smart-$(basename "$disk").txt" 2>/dev/null || true
    return $rc
}

# --- Generate manifest covering all static content types ---
generate_manifest() {
    local ts
    ts=$(date '+%Y%m%d-%H%M%S')
    local drive_uuid
    drive_uuid=$(blkid -s UUID -o value "$(resolve_device)" 2>/dev/null || echo "unknown")
    local short_uuid="${drive_uuid:0:8}"
    local manifest_on_drive="${MOUNTPOINT}/.backup-manifest-latest.txt"
    local manifest_archive="${MANIFEST_DIR}/manifest-${short_uuid}-${ts}.txt"
    local total_files=0

    log_info "Generating manifest (checksumming static content)..."

    {
        echo "# USB Storage Manifest"
        echo "# Generated: $(date -Iseconds)"
        echo "# Drive UUID: ${drive_uuid}"
        echo "# Drive Label: ${LABEL}"
        echo "# Hostname: $(hostname)"
        echo "# Content types: ${CONTENT_TYPES}"
        echo "#"
        echo "# Format: sha256  size_bytes  mod_date  content_type/filename"
        echo "# Note: images/ and import/ excluded (live/transient data)"
        echo "# Files >10GB use partial checksum (first+last 100MB)"
        echo "# ───────────────────────────────────────────────────────────"

        for mctype in $MANIFEST_CONTENT_TYPES; do
            if ! has_content_type "$mctype"; then
                continue
            fi

            local dir_rel
            dir_rel=$(content_dir "$mctype")
            local full_dir="${MOUNTPOINT}/${dir_rel}"
            local pattern
            pattern=$(content_file_pattern "$mctype")

            [[ ! -d "$full_dir" ]] && continue
            [[ -z "$pattern" ]] && continue

            local section_count=0

            while IFS= read -r fpath; do
                [[ -z "$fpath" ]] && continue
                [[ ! -f "$fpath" ]] && continue

                local fname
                fname=$(basename "$fpath")
                local fsize fdate_human fhash
                fsize=$(stat -c '%s' "$fpath" 2>/dev/null || echo "0")
                fdate_human=$(stat -c '%y' "$fpath" 2>/dev/null | cut -d. -f1)

                if (( fsize > 10737418240 )); then
                    local hh ht
                    hh=$(head -c 104857600 "$fpath" | sha256sum | awk '{print $1}')
                    ht=$(tail -c 104857600 "$fpath" | sha256sum | awk '{print $1}')
                    fhash="partial:${hh:0:16}+${ht:0:16}"
                else
                    fhash=$(sha256sum "$fpath" | awk '{print $1}')
                fi

                echo "${fhash}  ${fsize}  ${fdate_human}  ${mctype}/${fname}"
                (( section_count++ ))
                (( total_files++ ))
            done < <(find "$full_dir" -maxdepth 1 -type f -name "$pattern" 2>/dev/null | sort)

        done

        echo "# ───────────────────────────────────────────────────────────"
        echo "# Total files: ${total_files}"
        echo "# Disk usage: $(du -sh "$MOUNTPOINT" 2>/dev/null | awk '{print $1}')"
    } > "$manifest_on_drive"

    cp "$manifest_on_drive" "$manifest_archive" 2>/dev/null || true

    log_ok "Manifest: ${total_files} files checksummed."
    log_ok "Archived: ${manifest_archive}"
}

# --- Verify checksums against existing manifest (READ-ONLY — never rewrites) ---
verify_checksums_readonly() {
    local manifest="$1"

    [[ ! -f "$manifest" ]] && { log_err "Manifest not found: $manifest"; return 1; }

    log_info "Verifying checksums against manifest (read-only)..."
    echo ""

    local errors=0 checked=0 ok=0

    while IFS= read -r line; do
        [[ "$line" == \#* ]] && continue
        [[ -z "$line" ]] && continue

        local m_hash m_size m_key
        m_hash=$(echo "$line" | awk '{print $1}')
        m_size=$(echo "$line" | awk '{print $2}')
        m_key=$(echo "$line" | awk '{print $4}')
        [[ -z "$m_key" ]] && continue
        (( checked++ ))

        local m_ctype m_fname m_dir fpath
        m_ctype=$(echo "$m_key" | cut -d/ -f1)
        m_fname=$(echo "$m_key" | cut -d/ -f2-)
        m_dir=$(content_dir "$m_ctype")
        fpath="${MOUNTPOINT}/${m_dir}/${m_fname}"

        if [[ ! -f "$fpath" ]]; then
            echo -e "  ${_R}MISSING:  ${m_key}${_N}"
            (( errors++ ))
            continue
        fi

        local cur_size
        cur_size=$(stat -c '%s' "$fpath" 2>/dev/null || echo "0")
        if [[ "$cur_size" != "$m_size" ]]; then
            echo -e "  ${_R}SIZE MISMATCH: ${m_key} (manifest: ${m_size}, actual: ${cur_size})${_N}"
            (( errors++ ))
            continue
        fi

        # Compute current hash
        local cur_hash
        if [[ "$m_hash" == partial:* ]]; then
            # Partial checksum — reproduce same method
            local hh ht
            hh=$(head -c 104857600 "$fpath" | sha256sum | awk '{print $1}')
            ht=$(tail -c 104857600 "$fpath" | sha256sum | awk '{print $1}')
            cur_hash="partial:${hh:0:16}+${ht:0:16}"
        else
            cur_hash=$(sha256sum "$fpath" | awk '{print $1}')
        fi

        if [[ "$cur_hash" != "$m_hash" ]]; then
            echo -e "  ${_R}HASH MISMATCH: ${m_key}${_N}"
            echo -e "  ${_R}  manifest: ${m_hash}${_N}"
            echo -e "  ${_R}  actual:   ${cur_hash}${_N}"
            (( errors++ ))
            continue
        fi

        echo -e "  ${_G}✓${_N} ${m_key}"
        (( ok++ ))
    done < "$manifest"

    echo ""
    if (( errors == 0 )); then
        log_ok "Checksum verification PASSED: ${ok}/${checked} file(s) OK."
    else
        log_err "Checksum verification FAILED: ${errors} error(s) in ${checked} file(s)!"
    fi
    return $errors
}

# --- Compare two manifests ---
compare_manifests() {
    local file_a="$1" file_b="$2"

    [[ ! -f "$file_a" ]] && { log_err "File not found: $file_a"; return 1; }
    [[ ! -f "$file_b" ]] && { log_err "File not found: $file_b"; return 1; }

    echo ""
    echo -e "${_C}  ┌── Manifest Comparison ────────────────────────────────────┐${_N}"

    local header_a header_b uuid_a uuid_b
    header_a=$(grep "^# Generated:" "$file_a" | head -1 | sed 's/# Generated: //')
    header_b=$(grep "^# Generated:" "$file_b" | head -1 | sed 's/# Generated: //')
    uuid_a=$(grep "^# Drive UUID:" "$file_a" | head -1 | awk '{print $4}')
    uuid_b=$(grep "^# Drive UUID:" "$file_b" | head -1 | awk '{print $4}')

    echo "  │ A: $(basename "$file_a")"
    echo "  │    Generated: ${header_a}  UUID: ${uuid_a:0:8}..."
    echo "  │ B: $(basename "$file_b")"
    echo "  │    Generated: ${header_b}  UUID: ${uuid_b:0:8}..."
    echo "  │"

    local names_a names_b
    names_a=$(grep -v '^#' "$file_a" | grep -v '^$' | awk '{print $4}' | sort)
    names_b=$(grep -v '^#' "$file_b" | grep -v '^$' | awk '{print $4}' | sort)

    local only_a only_b common
    only_a=$(comm -23 <(echo "$names_a") <(echo "$names_b") | grep -c . 2>/dev/null || echo 0)
    only_b=$(comm -13 <(echo "$names_a") <(echo "$names_b") | grep -c . 2>/dev/null || echo 0)
    common=$(comm -12 <(echo "$names_a") <(echo "$names_b"))

    local n_common n_changed=0
    n_common=$(echo "$common" | grep -c . 2>/dev/null || echo 0)

    while IFS= read -r fname; do
        [[ -z "$fname" ]] && continue
        local ha hb
        ha=$(grep -v '^#' "$file_a" | grep "  ${fname}$" | awk '{print $1}' | head -1)
        hb=$(grep -v '^#' "$file_b" | grep "  ${fname}$" | awk '{print $1}' | head -1)
        if [[ "$ha" != "$hb" ]]; then
            (( n_changed++ ))
            echo -e "  │ ${_R}  CHANGED: ${fname}${_N}"
        fi
    done <<< "$common"

    local n_identical=$(( n_common - n_changed ))

    if (( only_a == 0 && only_b == 0 && n_changed == 0 )); then
        echo -e "  │ ${_G}✓ Manifests are IDENTICAL (${n_identical} files match)${_N}"
    else
        (( n_changed > 0 )) && echo -e "  │ ${_R}Changed (same name, different hash): ${n_changed}${_N}"

        if (( only_a > 0 )); then
            echo -e "  │ ${_Y}Only in A: ${only_a} file(s)${_N}"
            comm -23 <(echo "$names_a") <(echo "$names_b") | head -10 | while IFS= read -r f; do
                echo "  │   + $f"
            done
            (( only_a > 10 )) && echo "  │   ... and $(( only_a - 10 )) more"
        fi

        if (( only_b > 0 )); then
            echo -e "  │ ${_Y}Only in B: ${only_b} file(s)${_N}"
            comm -13 <(echo "$names_a") <(echo "$names_b") | head -10 | while IFS= read -r f; do
                echo "  │   + $f"
            done
            (( only_b > 10 )) && echo "  │   ... and $(( only_b - 10 )) more"
        fi

        echo -e "  │ Identical: ${n_identical}"
    fi

    echo -e "${_C}  └──────────────────────────────────────────────────────────┘${_N}"
    echo ""
}

# --- Disk space check ---
check_disk_space() {
    if ! findmnt -rn "$MOUNTPOINT" &>/dev/null; then return 0; fi
    local pct_used
    pct_used=$(df "$MOUNTPOINT" | tail -1 | awk '{gsub(/%/,""); print $5}')
    if [[ "$pct_used" =~ ^[0-9]+$ ]]; then
        if (( pct_used >= DISK_CRIT_PCT )); then
            log_err "Disk usage at ${pct_used}% — CRITICAL!"
            echo -e "  ${_R}${_B}⚠  CRITICAL: Disk ${pct_used}% full!${_N}"
        elif (( pct_used >= DISK_WARN_PCT )); then
            log_warn "Disk usage at ${pct_used}%."
            echo -e "  ${_Y}⚠  WARNING: Disk ${pct_used}% full.${_N}"
        fi
    fi
}
