            exit 0 ;;
    esac
done

echo ""
log_info "=== USB Backup Unmount ==="

# Safety: check for running vzdump
if [[ "$FORCE" == "false" ]]; then
    VZDUMP_PIDS=$(pgrep -f "vzdump" 2>/dev/null || true)
    if [[ -n "$VZDUMP_PIDS" ]]; then
        log_err "vzdump is running (PIDs: ${VZDUMP_PIDS}). Wait or use --force."
        exit 1
    fi
fi

# Safety: check for open files
if findmnt -rn "$MOUNTPOINT" &>/dev/null && [[ "$FORCE" == "false" ]]; then
    OPEN_COUNT=$(lsof +D "$MOUNTPOINT" 2>/dev/null | tail -n +2 | wc -l || echo 0)
    if (( OPEN_COUNT > 0 )); then
        log_warn "${OPEN_COUNT} open file(s) on ${MOUNTPOINT}:"
        lsof +D "$MOUNTPOINT" 2>/dev/null | head -10 | sed 's/^/    /'
        echo ""
        read -rp "  Continue anyway? [y/N]: " CONT
        [[ "$CONT" != "y" && "$CONT" != "Y" ]] && { log_info "Aborted."; exit 0; }
    fi
