#!/bin/bash
# usb-backup-verify — Verify backup integrity or compare manifests
# Usage:
#   usb-backup-verify                        Verify drive files vs manifest
#   usb-backup-verify --rechecksum           Rehash all files + compare to manifest
#   usb-backup-verify --compare <file>       Compare drive manifest vs saved file
#   usb-backup-verify --compare <a> <b>      Compare two manifest files
