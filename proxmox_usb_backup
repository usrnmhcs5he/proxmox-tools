MODE="integrity"
FILE_A=""
FILE_B=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --compare)
            MODE="compare"; shift
            [[ $# -ge 1 ]] && FILE_A="$1" && shift
            [[ $# -ge 1 ]] && FILE_B="$1" && shift
