#!/bin/bash
# ==============================================================================
# Proxmox USB SSD Backup Setup
# ==============================================================================
# Version History:
#   v1 - 2026-02-23 - Initial proposal (user draft)
#   v2 - 2026-02-23 - Rewrite: auto-detect, nofail, companion scripts
#   v3 - 2026-02-23 - Full suite: pre-format detection, SMART health checks,
#                      backup manifest with sha256 + cross-drive comparison,
#                      LABEL-based fstab for drive rotation, comprehensive
#                      logging, uninstall script, shared config/functions
# ==============================================================================
#
# Purpose:  Format a removable USB SSD for use as Proxmox VE backup storage.
#           Installs a full management suite for safe daily operations.
#
# Usage:    bash /root/setup-usb-backup.sh
# Requires: root, Proxmox VE host
#
# Installed components:
#   /etc/usb-backup/config        - Shared configuration
#   /etc/usb-backup/functions     - Shared bash functions (logging, SMART, etc.)
#   /etc/usb-backup/manifests/    - Stored manifest copies for offline comparison
#   /usr/local/sbin/usb-backup-mount     - Mount + enable + SMART health check
#   /usr/local/sbin/usb-backup-unmount   - Manifest + disable + unmount + eject
#   /usr/local/sbin/usb-backup-status    - Device/mount/storage/health overview
#   /usr/local/sbin/usb-backup-verify    - Integrity check + manifest comparison
#   /usr/local/sbin/usb-backup-uninstall - Clean removal of all components
#   /var/log/usb-backup.log              - Operation log
#
# Drive rotation:
#   Uses LABEL= in fstab so any ext4 disk labeled 'pve-backup' will mount
#   to the same mountpoint. Label all rotation drives identically during setup.
# ==============================================================================

set -euo pipefail

# ══════════════════════════════════════════════════════════════════════════════
# CONFIGURATION (also written to /etc/usb-backup/config during install)
# ══════════════════════════════════════════════════════════════════════════════
MOUNTPOINT="/mnt/usb-backup"
STORAGE_ID="usb-backup"
LABEL="pve-backup"
CONFIG_DIR="/etc/usb-backup"
MANIFEST_DIR="${CONFIG_DIR}/manifests"
LOG_FILE="/var/log/usb-backup.log"
SCRIPTS_DIR="/usr/local/sbin"

# Size safety bounds (adjust per your hardware)
MIN_SIZE_BYTES=50000000000      # ~50 GB
MAX_SIZE_BYTES=4400000000000    # ~4 TB

# SMART warning thresholds
SMART_WEAR_WARN=80             # Warn at 80% wear (normalized value drops below 20)
SMART_REALLOC_WARN=10          # Warn if >10 reallocated sectors
SMART_TEMP_WARN=65             # Warn if temperature >65C

# Disk space thresholds (percent used)
DISK_WARN_PCT=80
DISK_CRIT_PCT=90

# ══════════════════════════════════════════════════════════════════════════════
# TERMINAL HELPERS
# ══════════════════════════════════════════════════════════════════════════════
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

_log_file() {
    local level="$1"; shift
    echo "$(date '+%Y-%m-%d %H:%M:%S') [${level}] (setup) $*" >> "$LOG_FILE" 2>/dev/null || true
}
msg()  { echo -e "${GREEN}[OK]${NC}    $1"; _log_file "OK" "$1"; }
warn() { echo -e "${YELLOW}[WARN]${NC}  $1"; _log_file "WARN" "$1"; }
err()  { echo -e "${RED}[ERROR]${NC} $1" >&2; _log_file "ERROR" "$1"; }
info() { echo -e "${CYAN}[INFO]${NC}  $1"; _log_file "INFO" "$1"; }
die()  { err "$1"; exit 1; }

# ══════════════════════════════════════════════════════════════════════════════
# PRE-FLIGHT CHECKS
# ══════════════════════════════════════════════════════════════════════════════
[[ $EUID -ne 0 ]] && die "This script must be run as root."
command -v pvesm &>/dev/null || die "pvesm not found — this script requires a Proxmox VE host."

# Ensure log file exists
mkdir -p "$(dirname "$LOG_FILE")"
touch "$LOG_FILE"

# Install smartmontools if missing (needed for SMART health checks)
if ! command -v smartctl &>/dev/null; then
    warn "smartmontools not installed. Installing for SSD health monitoring..."
    apt-get update -qq && apt-get install -y -qq smartmontools 2>/dev/null || true
    if command -v smartctl &>/dev/null; then
        msg "smartmontools installed successfully."
    else
        warn "Could not install smartmontools. SMART health checks will be unavailable."
    fi
fi

# ══════════════════════════════════════════════════════════════════════════════
# DEVICE SELECTION
# ══════════════════════════════════════════════════════════════════════════════
echo ""
echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║          Proxmox USB Backup Storage Setup  (v3)            ║${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"
echo ""
info "Scanning for removable USB/SATA storage devices..."
echo ""
echo "  All block devices:"
echo "  ─────────────────────────────────────────────────────────────"
lsblk -d -o NAME,SIZE,MODEL,TRAN,RM,TYPE | grep -E "disk|NAME" | sed 's/^/  /'
echo "  ─────────────────────────────────────────────────────────────"
echo ""

# Find boot disk to exclude
BOOT_DISK=$(lsblk -ndo PKNAME "$(findmnt -no SOURCE /)" 2>/dev/null | head -1)

# Collect USB/removable candidates
declare -a CANDIDATES=()
while IFS= read -r devpath; do
    DEV_NAME=$(basename "$devpath")
    [[ "$DEV_NAME" == "$BOOT_DISK" ]] && continue
    CANDIDATES+=("$devpath")
done < <(lsblk -dnpo NAME,TRAN,RM,TYPE | awk '$4=="disk" && ($2=="usb" || $3==1) {print $1}')

if [[ ${#CANDIDATES[@]} -eq 0 ]]; then
    warn "No removable USB storage detected automatically."
    echo "  You can manually enter a device path (e.g., /dev/sdb)."
    echo ""
    read -rp "  Enter device path (or Enter to abort): " DEVICE
    [[ -z "$DEVICE" ]] && die "Aborted — no device selected."
    [[ ! -b "$DEVICE" ]] && die "$DEVICE is not a valid block device."
elif [[ ${#CANDIDATES[@]} -eq 1 ]]; then
    DEVICE="${CANDIDATES[0]}"
    info "Found one removable device: $DEVICE"
else
    info "Found multiple removable devices:"
    for i in "${!CANDIDATES[@]}"; do
        DEV="${CANDIDATES[$i]}"
        DEV_INFO=$(lsblk -dno SIZE,MODEL "$DEV" 2>/dev/null | xargs)
        echo "    [$((i+1))] $DEV  ($DEV_INFO)"
    done
    echo ""
    read -rp "  Select device number [1-${#CANDIDATES[@]}]: " CHOICE
    if [[ "$CHOICE" =~ ^[0-9]+$ ]] && (( CHOICE >= 1 && CHOICE <= ${#CANDIDATES[@]} )); then
        DEVICE="${CANDIDATES[$((CHOICE-1))]}"
    else
        die "Invalid selection."
    fi
fi

# Normalize: strip trailing partition numbers, ensure /dev/ prefix
[[ "$DEVICE" != /dev/* ]] && DEVICE="/dev/$DEVICE"
DEVICE=$(echo "$DEVICE" | sed 's/p\?[0-9]*$//')

info "Selected device: $DEVICE"

# ══════════════════════════════════════════════════════════════════════════════
# SAFETY: SIZE CHECK
# ══════════════════════════════════════════════════════════════════════════════
SIZE=$(blockdev --getsize64 "$DEVICE" 2>/dev/null || echo 0)
SIZE_GB=$(( SIZE / 1073741824 ))

if [[ "$SIZE" -lt "$MIN_SIZE_BYTES" ]] || [[ "$SIZE" -gt "$MAX_SIZE_BYTES" ]]; then
    err "Device size ${SIZE_GB} GB outside expected range ($(( MIN_SIZE_BYTES/1073741824 ))-$(( MAX_SIZE_BYTES/1073741824 )) GB)."
    die "Adjust MIN_SIZE_BYTES/MAX_SIZE_BYTES at top of script if this is intentional."
fi

# ══════════════════════════════════════════════════════════════════════════════
# FEATURE 1: PRE-FORMAT DETECTION — skip format if already set up
# ══════════════════════════════════════════════════════════════════════════════
SKIP_FORMAT=false

# Check first partition for existing pve-backup label
EXISTING_PART=""
for candidate in "${DEVICE}1" "${DEVICE}p1"; do
    [[ -b "$candidate" ]] && EXISTING_PART="$candidate" && break
done

if [[ -n "$EXISTING_PART" ]]; then
    EXISTING_LABEL=$(blkid -s LABEL -o value "$EXISTING_PART" 2>/dev/null || true)
    EXISTING_FS=$(blkid -s TYPE -o value "$EXISTING_PART" 2>/dev/null || true)
    EXISTING_UUID=$(blkid -s UUID -o value "$EXISTING_PART" 2>/dev/null || true)

    if [[ "$EXISTING_LABEL" == "$LABEL" ]] && [[ "$EXISTING_FS" == "ext4" ]]; then
        echo ""
        echo -e "${GREEN}  ┌─────────────────────────────────────────────────────────┐${NC}"
        echo -e "${GREEN}  │  EXISTING SETUP DETECTED                                │${NC}"
        echo -e "${GREEN}  │  Label: ${EXISTING_LABEL}  FS: ${EXISTING_FS}  UUID: ${EXISTING_UUID:0:8}...  │${NC}"
        echo -e "${GREEN}  └─────────────────────────────────────────────────────────┘${NC}"
        echo ""
        echo "  This device already has an ext4 filesystem labeled '$LABEL'."
        echo "  You can re-register it without formatting (preserves existing backups)."
        echo ""
        echo "    [1] Re-register only (keep data)"
        echo "    [2] Full format (ERASE ALL DATA)"
        echo "    [3] Abort"
        echo ""
        read -rp "  Choose [1/2/3]: " REUSE_CHOICE
        case "$REUSE_CHOICE" in
            1)
                SKIP_FORMAT=true
                info "Skipping format — will re-register existing filesystem."
                ;;
            2)
                info "Full format selected."
                ;;
            *)
                die "Aborted."
                ;;
        esac
    fi
fi

# ══════════════════════════════════════════════════════════════════════════════
# DESTRUCTIVE OPERATIONS (only if not re-registering)
# ══════════════════════════════════════════════════════════════════════════════
if [[ "$SKIP_FORMAT" == "false" ]]; then
    echo ""
    echo -e "${RED}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}║                    CRITICAL WARNING                        ║${NC}"
    echo -e "${RED}║       This will ERASE ALL DATA on ${DEVICE}               ║${NC}"
    echo -e "${RED}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo "  Device:  $DEVICE"
    echo "  Size:    ${SIZE_GB} GB"
    lsblk -d -o NAME,SIZE,MODEL,SERIAL,TRAN "$DEVICE" 2>/dev/null | sed 's/^/  /'
    echo ""
    echo "  Current content:"
    lsblk -f "$DEVICE" 2>/dev/null | sed 's/^/    /' || true
    echo ""

    read -rp "  Type YES to continue: " CONFIRM1
    [[ "$CONFIRM1" != "YES" ]] && die "Aborted by user."
    read -rp "  Type DESTROY to confirm data destruction: " CONFIRM2
    [[ "$CONFIRM2" != "DESTROY" ]] && die "Aborted by user."

    # --- Unmount existing partitions ---
    info "Unmounting any existing partitions on ${DEVICE}..."
    for part in "${DEVICE}"*; do
        [[ "$part" == "$DEVICE" ]] && continue
        if findmnt -rn "$part" &>/dev/null; then
            warn "  Unmounting $part..."
            umount -f "$part" 2>/dev/null || true
        fi
    done
    findmnt -rn "$DEVICE" &>/dev/null && umount -f "$DEVICE" 2>/dev/null || true
    msg "Partitions unmounted."

    # --- Wipe signatures ---
    info "Wiping all filesystem signatures and partition table..."
    wipefs --all --force "$DEVICE" 2>/dev/null || true
    dd if=/dev/zero of="$DEVICE" bs=1M count=10 status=none 2>/dev/null || true
    msg "Device wiped."

    # --- Create GPT + ext4 partition ---
    info "Creating GPT partition table + ext4 partition..."
    parted -s "$DEVICE" mklabel gpt
    parted -s "$DEVICE" mkpart primary ext4 1MiB 100%
    sleep 2
    partprobe "$DEVICE" 2>/dev/null || true
    sleep 2

    # Find partition device path (sdX1 or sdXp1 or nvmeXnYp1)
    PART=""
    for candidate in "${DEVICE}1" "${DEVICE}p1"; do
        [[ -b "$candidate" ]] && PART="$candidate" && break
    done
    if [[ -z "$PART" ]]; then
        sleep 3; partprobe "$DEVICE" 2>/dev/null || true; sleep 2
        for candidate in "${DEVICE}1" "${DEVICE}p1"; do
            [[ -b "$candidate" ]] && PART="$candidate" && break
        done
        [[ -z "$PART" ]] && die "Partition not found after partitioning ${DEVICE}."
    fi
    msg "Partition created: $PART"

    # --- Format ext4 ---
    info "Formatting as ext4 with label '${LABEL}'..."
    mkfs.ext4 -F -L "$LABEL" "$PART"
    msg "Formatted."
else
    # Re-register path: use existing partition
    PART="$EXISTING_PART"
fi

UUID=$(blkid -s UUID -o value "$PART")
[[ -z "$UUID" ]] && die "Failed to read UUID from $PART."
info "Partition: $PART  UUID: $UUID  Label: $LABEL"

# ══════════════════════════════════════════════════════════════════════════════
# FSTAB CONFIGURATION (LABEL-based for drive rotation — Feature 7)
# ══════════════════════════════════════════════════════════════════════════════
info "Configuring mount point and fstab..."

mkdir -p "$MOUNTPOINT"

# Backup fstab
FSTAB_BACKUP="/etc/fstab.pre-usb-backup-$(date +%Y%m%d-%H%M%S)"
cp /etc/fstab "$FSTAB_BACKUP"
msg "fstab backed up to $FSTAB_BACKUP"

# Remove any previous usb-backup entries (idempotent)
sed -i '/# USB backup SSD (pve-backup)/d' /etc/fstab
sed -i "\|${MOUNTPOINT}|d" /etc/fstab

# LABEL-based mount allows any drive with label=pve-backup to work
# Options explained:
#   noauto                      - don't mount at boot (prevents hang if absent)
#   nofail                      - don't enter emergency mode if missing
#   x-systemd.automount         - mount on first access via systemd
#   x-systemd.device-timeout=5  - give up after 5s if device missing
#   x-systemd.idle-timeout=0    - never auto-unmount
#   noatime                     - performance: skip access time updates
#   errors=continue             - don't remount-ro on errors (removable media)
FSTAB_OPTS="noauto,nofail,noatime,x-systemd.automount,x-systemd.device-timeout=5,x-systemd.idle-timeout=0,errors=continue"
{
    echo "# USB backup SSD (pve-backup) — managed by usb-backup-setup ($(date +%Y-%m-%d))"
    echo "LABEL=${LABEL}  ${MOUNTPOINT}  ext4  ${FSTAB_OPTS}  0  2"
} >> /etc/fstab

systemctl daemon-reload
msg "fstab updated (LABEL-based) and systemd reloaded."

# ══════════════════════════════════════════════════════════════════════════════
# MOUNT AND PREPARE DIRECTORY STRUCTURE
# ══════════════════════════════════════════════════════════════════════════════
info "Mounting and preparing backup directory structure..."

# Unmount first if already mounted (idempotent)
findmnt -rn "$MOUNTPOINT" &>/dev/null && umount "$MOUNTPOINT" 2>/dev/null || true
mount "$MOUNTPOINT"

# Proxmox vzdump expects dump/ subdirectory
mkdir -p "${MOUNTPOINT}/dump"
chown root:root "${MOUNTPOINT}/dump"
chmod 755 "${MOUNTPOINT}/dump"

# Disk identity marker
cat > "${MOUNTPOINT}/.backup-disk-info" <<EOF
label=${LABEL}
uuid=${UUID}
device=${DEVICE}
partition=${PART}
created=$(date -Iseconds)
setup_version=3
purpose=Proxmox VE backup storage
EOF

msg "Mounted at $MOUNTPOINT — dump/ directory ready."

# ══════════════════════════════════════════════════════════════════════════════
# REGISTER IN PROXMOX VE
# ══════════════════════════════════════════════════════════════════════════════
info "Registering storage in Proxmox..."

if pvesm status 2>/dev/null | grep -q "^${STORAGE_ID}"; then
    warn "Storage '${STORAGE_ID}' exists — removing and re-adding..."
    pvesm remove "$STORAGE_ID" 2>/dev/null || true
fi

pvesm add dir "$STORAGE_ID" \
    --path "$MOUNTPOINT" \
    --content backup \
    --is_mountpoint 1

msg "Proxmox storage '${STORAGE_ID}' registered."

# ══════════════════════════════════════════════════════════════════════════════
# INSTALL SHARED CONFIG AND FUNCTIONS
# ══════════════════════════════════════════════════════════════════════════════
info "Installing configuration and shared functions..."

mkdir -p "$CONFIG_DIR" "$MANIFEST_DIR"

# ── /etc/usb-backup/config ──────────────────────────────────────────────────
cat > "${CONFIG_DIR}/config" <<CFGEOF
# USB Backup configuration — generated by setup-usb-backup.sh v3
# $(date -Iseconds)
# Edit with care — companion scripts source this file.

MOUNTPOINT="${MOUNTPOINT}"
STORAGE_ID="${STORAGE_ID}"
LABEL="${LABEL}"
CONFIG_DIR="${CONFIG_DIR}"
MANIFEST_DIR="${MANIFEST_DIR}"
LOG_FILE="${LOG_FILE}"

# SMART thresholds
SMART_WEAR_WARN=${SMART_WEAR_WARN}
SMART_REALLOC_WARN=${SMART_REALLOC_WARN}
SMART_TEMP_WARN=${SMART_TEMP_WARN}

# Disk space thresholds (percent used)
DISK_WARN_PCT=${DISK_WARN_PCT}
DISK_CRIT_PCT=${DISK_CRIT_PCT}
CFGEOF

# ── /etc/usb-backup/functions ───────────────────────────────────────────────
cat > "${CONFIG_DIR}/functions" <<'FUNCEOF'
# USB Backup shared functions — sourced by all companion scripts
# shellcheck shell=bash

# --- Terminal colors (only when stdout is a terminal) ---
if [[ -t 1 ]]; then
    _R='\033[0;31m'; _G='\033[0;32m'; _Y='\033[1;33m'
    _C='\033[0;36m'; _B='\033[1m'; _N='\033[0m'
else
    _R=''; _G=''; _Y=''; _C=''; _B=''; _N=''
fi

# --- Logging (stdout + file) ---
_log() {
    local level="$1" caller="$2"; shift 2
    echo "$(date '+%Y-%m-%d %H:%M:%S') [${level}] (${caller}) $*" >> "$LOG_FILE" 2>/dev/null || true
}
log_ok()   { echo -e "${_G}[OK]${_N}    $1"; _log "OK" "${SCRIPT_NAME:-unknown}" "$1"; }
log_warn() { echo -e "${_Y}[WARN]${_N}  $1"; _log "WARN" "${SCRIPT_NAME:-unknown}" "$1"; }
log_err()  { echo -e "${_R}[ERROR]${_N} $1" >&2; _log "ERROR" "${SCRIPT_NAME:-unknown}" "$1"; }
log_info() { echo -e "${_C}[INFO]${_N}  $1"; _log "INFO" "${SCRIPT_NAME:-unknown}" "$1"; }

# --- Resolve which block device the label currently maps to ---
resolve_device() {
    # Returns the partition device (e.g. /dev/sdb1)
    blkid -L "$LABEL" 2>/dev/null || true
}

resolve_disk() {
    # Returns the whole-disk device (e.g. /dev/sdb) from a partition path
    local part="$1" disk
    disk=$(lsblk -ndo PKNAME "$part" 2>/dev/null | head -1)
    [[ -n "$disk" ]] && echo "/dev/$disk" || echo ""
}

# --- SMART health check (Feature 3) ---
smart_check() {
    # Usage: smart_check /dev/sdX
    # Returns 0=OK, 1=warnings found, 2=smartctl unavailable/unsupported
    local disk="$1"
    local rc=0

    if ! command -v smartctl &>/dev/null; then
        log_warn "SMART: smartctl not installed — skipping health check."
        log_warn "SMART: Install with: apt-get install smartmontools"
        return 2
    fi

    # Try multiple device type flags (USB SATA bridges often need -d sat)
    local smart_output="" smart_rc=1
    for dtype in sat auto ""; do
        local flag=""
        [[ -n "$dtype" ]] && flag="-d $dtype"
        # shellcheck disable=SC2086
        if smart_output=$(smartctl -a $flag "$disk" 2>&1); then
            smart_rc=0
            break
        fi
        smart_rc=$?
    done

    if [[ $smart_rc -ne 0 ]] && ! echo "$smart_output" | grep -qi "SMART"; then
        log_warn "SMART: Could not read SMART data from $disk."
        log_warn "SMART: USB enclosure may block SMART passthrough."
        return 2
    fi

    echo ""
    echo -e "${_C}  ┌── SMART Health Summary ─────────────────────────────────┐${_N}"

    # Overall health
    local health
    health=$(echo "$smart_output" | grep -i "SMART overall-health" | awk -F': ' '{print $2}' | xargs)
    if [[ -n "$health" ]]; then
        if [[ "$health" != "PASSED" ]]; then
            echo -e "  │ ${_R}Overall:              ${health}${_N}"
            rc=1
        else
            echo -e "  │ ${_G}Overall:              PASSED${_N}"
        fi
    fi

    # Temperature (SATA attr 194 or NVMe)
    local temp=""
    temp=$(echo "$smart_output" | grep -E "^194 " | awk '{print $10}' | head -1)
    [[ -z "$temp" ]] && temp=$(echo "$smart_output" | grep -i "^Temperature:" | head -1 | grep -oP '\d+' | head -1)
    if [[ -n "$temp" ]] && [[ "$temp" =~ ^[0-9]+$ ]]; then
        if (( temp > SMART_TEMP_WARN )); then
            echo -e "  │ ${_R}Temperature:          ${temp}°C (threshold: ${SMART_TEMP_WARN}°C)${_N}"
            rc=1
        else
            echo -e "  │ ${_G}Temperature:          ${temp}°C${_N}"
        fi
    fi

    # Reallocated sectors (SATA attribute 5)
    local realloc=""
    realloc=$(echo "$smart_output" | grep -E "^  5 " | awk '{print $10}')
    if [[ -n "$realloc" ]] && [[ "$realloc" =~ ^[0-9]+$ ]]; then
        if (( realloc > SMART_REALLOC_WARN )); then
            echo -e "  │ ${_R}Reallocated sectors:  ${realloc} (threshold: ${SMART_REALLOC_WARN})${_N}"
            rc=1
        else
            echo -e "  │ ${_G}Reallocated sectors:  ${realloc}${_N}"
        fi
    fi

    # Pending sectors (SATA attribute 197)
    local pending=""
    pending=$(echo "$smart_output" | grep -E "^197 " | awk '{print $10}')
    if [[ -n "$pending" ]] && [[ "$pending" =~ ^[0-9]+$ ]] && (( pending > 0 )); then
        echo -e "  │ ${_R}Pending sectors:      ${pending}${_N}"
        rc=1
    fi

    # Wear leveling (SATA attr 177/173/233 or NVMe Percentage Used)
    local wear_shown=false

    # NVMe: Percentage Used (most reliable — direct percentage)
    local nvme_pct=""
    nvme_pct=$(echo "$smart_output" | grep -i "Percentage Used" | grep -oP '\d+' | head -1)
    if [[ -n "$nvme_pct" ]] && [[ "$nvme_pct" =~ ^[0-9]+$ ]]; then
        if (( nvme_pct > SMART_WEAR_WARN )); then
            echo -e "  │ ${_R}SSD wear (NVMe):      ${nvme_pct}% used (threshold: ${SMART_WEAR_WARN}%)${_N}"
            rc=1
        else
            echo -e "  │ ${_G}SSD wear (NVMe):      ${nvme_pct}% used${_N}"
        fi
        wear_shown=true
    fi

    # SATA: Wear_Leveling_Count / Media_Wearout_Indicator — normalized VALUE
    # VALUE starts at 100 and decreases toward threshold
    if [[ "$wear_shown" == "false" ]]; then
        local wear_val=""
        wear_val=$(echo "$smart_output" | grep -iE "Wear_Leveling_Count|Media_Wearout_Indicator" | awk '{print $4}' | head -1)
        if [[ -n "$wear_val" ]] && [[ "$wear_val" =~ ^[0-9]+$ ]]; then
            local wear_used=$(( 100 - wear_val ))
            if (( wear_used > SMART_WEAR_WARN )); then
                echo -e "  │ ${_R}SSD wear (SATA):      ~${wear_used}% (value: ${wear_val}/100)${_N}"
                rc=1
            else
                echo -e "  │ ${_G}SSD wear (SATA):      ~${wear_used}% (value: ${wear_val}/100)${_N}"
            fi
            wear_shown=true
        fi
    fi

    # SSD Life Remaining (attr 231) — some drives use this
    if [[ "$wear_shown" == "false" ]]; then
        local life_val=""
        life_val=$(echo "$smart_output" | grep -i "SSD_Life_Remaining\|Life_Remaining" | awk '{print $4}' | head -1)
        if [[ -n "$life_val" ]] && [[ "$life_val" =~ ^[0-9]+$ ]]; then
            local life_used=$(( 100 - life_val ))
            echo -e "  │ ${_G}SSD life remaining:   ${life_val}%${_N}"
            wear_shown=true
        fi
    fi

    # Power-on hours
    local poh=""
    poh=$(echo "$smart_output" | grep -E "^  9 " | awk '{print $10}' | head -1)
    [[ -z "$poh" ]] && poh=$(echo "$smart_output" | grep -i "Power On Hours" | grep -oP '[\d,]+' | head -1 | tr -d ',')
    [[ -n "$poh" ]] && echo "  │ Power-on hours:      ${poh}"

    # Power cycle count
    local pcc=""
    pcc=$(echo "$smart_output" | grep -E "^ 12 " | awk '{print $10}' | head -1)
    [[ -z "$pcc" ]] && pcc=$(echo "$smart_output" | grep -i "Power Cycles" | grep -oP '[\d,]+' | head -1 | tr -d ',')
    [[ -n "$pcc" ]] && echo "  │ Power cycles:        ${pcc}"

    # Unexpected power loss (attr 174 / Unsafe Shutdowns for NVMe)
    local upl=""
    upl=$(echo "$smart_output" | grep -E "^174 " | awk '{print $10}')
    [[ -z "$upl" ]] && upl=$(echo "$smart_output" | grep -i "Unsafe Shutdowns" | grep -oP '[\d,]+' | head -1 | tr -d ',')
    if [[ -n "$upl" ]] && [[ "$upl" =~ ^[0-9]+$ ]] && (( upl > 0 )); then
        echo -e "  │ ${_Y}Unexpected power off: ${upl}${_N}"
    fi

    # CRC errors (attr 199) — indicates cable/connection issues
    local crc=""
    crc=$(echo "$smart_output" | grep -E "^199 " | awk '{print $10}')
    if [[ -n "$crc" ]] && [[ "$crc" =~ ^[0-9]+$ ]] && (( crc > 0 )); then
        echo -e "  │ ${_Y}UDMA CRC errors:     ${crc} (possible cable issue)${_N}"
    fi

    echo -e "${_C}  └──────────────────────────────────────────────────────────┘${_N}"

    if [[ $rc -eq 1 ]]; then
        _log "WARN" "${SCRIPT_NAME:-smart}" "Health warnings on $disk — review recommended"
        echo ""
        echo -e "  ${_R}${_B}⚠  SMART warnings detected! Consider replacing this drive.${_N}"
    fi
    echo ""

    # Save full SMART output for reference
    echo "$smart_output" > "${CONFIG_DIR}/last-smart-$(basename "$disk").txt" 2>/dev/null || true

    return $rc
}

# --- Generate backup manifest with checksums (Feature 4) ---
generate_manifest() {
    local dump_dir="${MOUNTPOINT}/dump"
    local ts
    ts=$(date '+%Y%m%d-%H%M%S')
    local drive_uuid
    drive_uuid=$(blkid -s UUID -o value "$(resolve_device)" 2>/dev/null || echo "unknown")
    local short_uuid="${drive_uuid:0:8}"
    local manifest_on_drive="${MOUNTPOINT}/.backup-manifest-latest.txt"
    local manifest_archive="${MANIFEST_DIR}/manifest-${short_uuid}-${ts}.txt"
    local file_count=0

    log_info "Generating backup manifest..."

    {
        echo "# USB Backup Manifest"
        echo "# Generated: $(date -Iseconds)"
        echo "# Drive UUID: ${drive_uuid}"
        echo "# Drive Label: ${LABEL}"
        echo "# Hostname: $(hostname)"
        echo "#"
        echo "# Format: sha256  size_bytes  mod_date  filename"
        echo "# ───────────────────────────────────────────────────────────"

        if [[ -d "$dump_dir" ]]; then
            while IFS= read -r fname; do
                [[ -z "$fname" ]] && continue
                local fpath="${dump_dir}/${fname}"
                local fsize fdate_human fhash
                fsize=$(stat -c '%s' "$fpath" 2>/dev/null || echo "0")
                fdate_human=$(stat -c '%y' "$fpath" 2>/dev/null | cut -d. -f1)

                # Large files (>10GB): partial checksum for speed
                # first 100MB + last 100MB + size
                if (( fsize > 10737418240 )); then
                    local hh ht
                    hh=$(head -c 104857600 "$fpath" | sha256sum | awk '{print $1}')
                    ht=$(tail -c 104857600 "$fpath" | sha256sum | awk '{print $1}')
                    fhash="partial:${hh:0:16}+${ht:0:16}"
                else
                    fhash=$(sha256sum "$fpath" | awk '{print $1}')
                fi

                echo "${fhash}  ${fsize}  ${fdate_human}  ${fname}"
                (( file_count++ ))
            done < <(find "$dump_dir" -maxdepth 1 -type f -name "vzdump-*" -printf '%f\n' | sort)
        fi

        echo "# ───────────────────────────────────────────────────────────"
        echo "# Total files: ${file_count}"
        echo "# Disk usage: $(du -sh "$dump_dir" 2>/dev/null | awk '{print $1}')"
    } > "$manifest_on_drive"

    # Archive a dated copy for offline comparison
    cp "$manifest_on_drive" "$manifest_archive" 2>/dev/null || true

    log_ok "Manifest: ${file_count} files checksummed."
    log_ok "Archived: ${manifest_archive}"
}

# --- Compare two manifests (Feature 4 — cross-drive) ---
compare_manifests() {
    local file_a="$1" file_b="$2"

    [[ ! -f "$file_a" ]] && { log_err "File not found: $file_a"; return 1; }
    [[ ! -f "$file_b" ]] && { log_err "File not found: $file_b"; return 1; }

    echo ""
    echo -e "${_C}  ┌── Manifest Comparison ────────────────────────────────────┐${_N}"

    local header_a header_b uuid_a uuid_b
    header_a=$(grep "^# Generated:" "$file_a" | head -1 | sed 's/# Generated: //')
    header_b=$(grep "^# Generated:" "$file_b" | head -1 | sed 's/# Generated: //')
    uuid_a=$(grep "^# Drive UUID:" "$file_a" | head -1 | awk '{print $4}')
    uuid_b=$(grep "^# Drive UUID:" "$file_b" | head -1 | awk '{print $4}')

    echo "  │ A: $(basename "$file_a")"
    echo "  │    Generated: ${header_a}  UUID: ${uuid_a:0:8}..."
    echo "  │ B: $(basename "$file_b")"
    echo "  │    Generated: ${header_b}  UUID: ${uuid_b:0:8}..."
    echo "  │"

    # Extract data lines: hash  size  date  filename
    local names_a names_b
    names_a=$(grep -v '^#' "$file_a" | grep -v '^$' | awk '{print $4}' | sort)
    names_b=$(grep -v '^#' "$file_b" | grep -v '^$' | awk '{print $4}' | sort)

    local only_a only_b common
    only_a=$(comm -23 <(echo "$names_a") <(echo "$names_b") | grep -c . 2>/dev/null || echo 0)
    only_b=$(comm -13 <(echo "$names_a") <(echo "$names_b") | grep -c . 2>/dev/null || echo 0)
    common=$(comm -12 <(echo "$names_a") <(echo "$names_b"))

    local n_common n_changed=0
    n_common=$(echo "$common" | grep -c . 2>/dev/null || echo 0)

    # Check common files for hash differences
    while IFS= read -r fname; do
        [[ -z "$fname" ]] && continue
        local ha hb
        ha=$(grep -v '^#' "$file_a" | grep "  ${fname}$" | awk '{print $1}' | head -1)
        hb=$(grep -v '^#' "$file_b" | grep "  ${fname}$" | awk '{print $1}' | head -1)
        if [[ "$ha" != "$hb" ]]; then
            (( n_changed++ ))
            echo -e "  │ ${_R}  CHANGED: ${fname}${_N}"
        fi
    done <<< "$common"

    local n_identical=$(( n_common - n_changed ))

    if (( only_a == 0 && only_b == 0 && n_changed == 0 )); then
        echo -e "  │ ${_G}✓ Manifests are IDENTICAL (${n_identical} files match)${_N}"
    else
        (( n_changed > 0 )) && echo -e "  │ ${_R}Changed (same name, different hash): ${n_changed}${_N}"

        if (( only_a > 0 )); then
            echo -e "  │ ${_Y}Only in A: ${only_a} file(s)${_N}"
            comm -23 <(echo "$names_a") <(echo "$names_b") | head -10 | while IFS= read -r f; do
                echo "  │   + $f"
            done
            (( only_a > 10 )) && echo "  │   ... and $(( only_a - 10 )) more"
        fi

        if (( only_b > 0 )); then
            echo -e "  │ ${_Y}Only in B: ${only_b} file(s)${_N}"
            comm -13 <(echo "$names_a") <(echo "$names_b") | head -10 | while IFS= read -r f; do
                echo "  │   + $f"
            done
            (( only_b > 10 )) && echo "  │   ... and $(( only_b - 10 )) more"
        fi

        echo -e "  │ Identical: ${n_identical}"
    fi

    echo -e "${_C}  └──────────────────────────────────────────────────────────┘${_N}"
    echo ""
}

# --- Check disk space and warn ---
check_disk_space() {
    if ! findmnt -rn "$MOUNTPOINT" &>/dev/null; then return 0; fi
    local pct_used
    pct_used=$(df "$MOUNTPOINT" | tail -1 | awk '{gsub(/%/,""); print $5}')
    if [[ "$pct_used" =~ ^[0-9]+$ ]]; then
        if (( pct_used >= DISK_CRIT_PCT )); then
            log_err "Disk usage at ${pct_used}% — CRITICAL! Backups may fail."
            echo -e "  ${_R}${_B}⚠  CRITICAL: Disk ${pct_used}% full!${_N}"
        elif (( pct_used >= DISK_WARN_PCT )); then
            log_warn "Disk usage at ${pct_used}% — approaching capacity."
            echo -e "  ${_Y}⚠  WARNING: Disk ${pct_used}% full.${_N}"
        fi
    fi
}
