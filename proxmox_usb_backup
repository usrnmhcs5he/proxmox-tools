if [[ "$DO_MANIFEST" == "true" ]] && findmnt -rn "$MOUNTPOINT" &>/dev/null; then
    generate_manifest
fi

# Disable Proxmox storage
log_info "Disabling Proxmox storage '${STORAGE_ID}'..."
pvesm set "$STORAGE_ID" --disable 1 2>/dev/null || true
