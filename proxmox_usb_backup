            echo "  usb-backup-verify                     Verify files vs manifest (size check)"
            echo "  usb-backup-verify --rechecksum        Re-hash + compare to existing manifest"
            echo "  usb-backup-verify --compare <file>    Compare drive manifest vs a saved one"
            echo "  usb-backup-verify --compare <a> <b>   Compare two manifest files directly"
            echo "  usb-backup-verify --list              List all archived manifests"
            exit 0 ;;
        *) log_err "Unknown option: $1"; exit 1 ;;
    esac
done

echo ""

case "$MODE" in
    list)
        log_info "Archived manifests (${MANIFEST_DIR}):"
