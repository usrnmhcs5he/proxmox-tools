    VZDUMP_PIDS=$(pgrep -f "vzdump" 2>/dev/null || true)
    if [[ -n "$VZDUMP_PIDS" ]]; then
        log_err "vzdump is running (PIDs: ${VZDUMP_PIDS}). Wait or use --force."
        exit 1
    fi
fi

# Safety: check open files (fuser is faster than lsof on large directories)
if findmnt -rn "$MOUNTPOINT" &>/dev/null && [[ "$FORCE" == "false" ]]; then
    FUSER_OUT=$(fuser -vm "$MOUNTPOINT" 2>&1 || true)
    if echo "$FUSER_OUT" | grep -q "[0-9]"; then
        log_warn "Open files/processes on ${MOUNTPOINT}:"
        echo "$FUSER_OUT" | head -15 | sed 's/^/    /'
        echo ""
        read -rp "  Continue anyway? [y/N]: " CONT
        [[ "$CONT" != "y" && "$CONT" != "Y" ]] && { log_info "Aborted."; exit 0; }
    fi
fi

PART=$(resolve_device 2>/dev/null) || true
DISK=""
[[ -n "$PART" ]] && DISK=$(resolve_disk "$PART")

# Generate manifest
if [[ "$DO_MANIFEST" == "true" ]] && findmnt -rn "$MOUNTPOINT" &>/dev/null; then
    generate_manifest
fi

# Disable Proxmox storage
log_info "Disabling Proxmox storage '${STORAGE_ID}'..."
pvesm set "$STORAGE_ID" --disable 1 2>/dev/null || true
sleep 1
log_ok "Storage disabled."

# Unmount
if findmnt -rn "$MOUNTPOINT" &>/dev/null; then
    log_info "Syncing filesystem..."
    sync
    log_info "Unmounting ${MOUNTPOINT}..."
    if ! umount "$MOUNTPOINT" 2>/dev/null; then
        log_warn "Normal unmount failed — trying lazy unmount..."
        umount -l "$MOUNTPOINT" || { log_err "Unmount failed. Check: fuser -vm ${MOUNTPOINT}"; exit 1; }
    fi
    log_ok "Unmounted."
else
    log_ok "Not currently mounted."
fi

# Stop automount
AUTOMOUNT_UNIT=$(systemd-escape --path --suffix=automount "$MOUNTPOINT" 2>/dev/null || true)
[[ -n "$AUTOMOUNT_UNIT" ]] && systemctl stop "$AUTOMOUNT_UNIT" 2>/dev/null || true

# Eject
if [[ "$DO_EJECT" == "true" ]]; then
    if [[ -n "$DISK" ]]; then
        log_info "Ejecting ${DISK}..."
        sync
        if command -v udisksctl &>/dev/null; then
            if udisksctl power-off -b "$DISK" 2>/dev/null; then
                log_ok "Device powered off (udisksctl). Safe to unplug."
            else
                echo 1 > "/sys/block/$(basename "$DISK")/device/delete" 2>/dev/null || true
                log_ok "Device removed (sysfs). Safe to unplug."
            fi
        else
            echo 1 > "/sys/block/$(basename "$DISK")/device/delete" 2>/dev/null || true
            log_ok "Device removed (sysfs). Safe to unplug."
        fi
        echo ""
        echo -e "  ${_G}${_B}✓  Safe to disconnect the USB drive.${_N}"
    else
        log_warn "Could not determine disk device for eject."
    fi
else
    echo ""
    log_info "Storage disabled and unmounted."
    echo "  To eject:     usb-backup-unmount --eject"
    echo "  To re-enable: usb-backup-mount"
fi
echo ""
SCRIPTEOF
chmod +x "${SCRIPTS_DIR}/usb-backup-unmount"

