            echo ""
            echo "  Available:"
            find "$MANIFEST_DIR" -name "manifest-*.txt" -type f -printf '    %f\n' 2>/dev/null | sort | tail -10
            exit 1
        fi
        ;;

    rechecksum)
        if ! findmnt -rn "$MOUNTPOINT" &>/dev/null; then
            log_err "Drive not mounted at ${MOUNTPOINT}."; exit 1
        fi

        # Save old manifest if it exists
        OLD_MANIFEST=""
        if [[ -f "${MOUNTPOINT}/.backup-manifest-latest.txt" ]]; then
            OLD_MANIFEST=$(mktemp)
            cp "${MOUNTPOINT}/.backup-manifest-latest.txt" "$OLD_MANIFEST"
        fi

        log_info "Generating fresh manifest with new checksums..."
        generate_manifest

        if [[ -n "$OLD_MANIFEST" ]] && [[ -f "$OLD_MANIFEST" ]]; then
            log_info "Comparing fresh checksums against previous manifest..."
            compare_manifests "${MOUNTPOINT}/.backup-manifest-latest.txt" "$OLD_MANIFEST"
            rm -f "$OLD_MANIFEST"
        else
            log_ok "First manifest generated. Run --rechecksum again later to detect changes."
        fi
        ;;

    integrity)
        if ! findmnt -rn "$MOUNTPOINT" &>/dev/null; then
            log_err "Drive not mounted at ${MOUNTPOINT}."; exit 1
        fi

        MANIFEST="${MOUNTPOINT}/.backup-manifest-latest.txt"
        if [[ ! -f "$MANIFEST" ]]; then
            log_warn "No manifest found. Generating one now..."
            generate_manifest
            log_ok "Manifest generated. Run verify again later to detect changes."
            exit 0
        fi

        log_info "Verifying files against manifest (size + existence check)..."
        echo ""

        ERRORS=0
        CHECKED=0
        DUMP_DIR="${MOUNTPOINT}/dump"

        while IFS= read -r line; do
            [[ "$line" == \#* ]] && continue
            [[ -z "$line" ]] && continue

            m_hash=$(echo "$line" | awk '{print $1}')
            m_size=$(echo "$line" | awk '{print $2}')
            m_fname=$(echo "$line" | awk '{print $4}')
            [[ -z "$m_fname" ]] && continue
            (( CHECKED++ ))

            fpath="${DUMP_DIR}/${m_fname}"
            if [[ ! -f "$fpath" ]]; then
                echo -e "  ${_R}MISSING:  ${m_fname}${_N}"
                (( ERRORS++ ))
                continue
            fi

            cur_size=$(stat -c '%s' "$fpath" 2>/dev/null || echo "0")
            if [[ "$cur_size" != "$m_size" ]]; then
                echo -e "  ${_R}SIZE MISMATCH: ${m_fname} (expected: ${m_size}, actual: ${cur_size})${_N}"
                (( ERRORS++ ))
                continue
            fi

            echo -e "  ${_G}✓${_N} ${m_fname}  (${cur_size} bytes)"
        done < "$MANIFEST"

        # Files on disk not in manifest
        EXTRA=0
        while IFS= read -r fname; do
            [[ -z "$fname" ]] && continue
            if ! grep -q "  ${fname}$" "$MANIFEST" 2>/dev/null; then
                echo -e "  ${_Y}NEW:      ${fname} (not in manifest)${_N}"
                (( EXTRA++ ))
            fi
        done < <(find "$DUMP_DIR" -maxdepth 1 -type f -name "vzdump-*" -printf '%f\n' 2>/dev/null | sort)

        echo ""
        if (( ERRORS == 0 )); then
            log_ok "Integrity OK: ${CHECKED} file(s), 0 errors."
        else
            log_err "Integrity FAILED: ${ERRORS} error(s) in ${CHECKED} file(s)!"
        fi
        (( EXTRA > 0 )) && log_info "${EXTRA} new file(s) since last manifest. Run --rechecksum to update."
        echo ""
        echo "  For full checksum verification: usb-backup-verify --rechecksum"
        echo ""
        ;;
esac
SCRIPTEOF
chmod +x "${SCRIPTS_DIR}/usb-backup-verify"

# ─────────────────────────────────────────────────────────────────────────────
# usb-backup-uninstall (Feature 10)
# ─────────────────────────────────────────────────────────────────────────────
cat > "${SCRIPTS_DIR}/usb-backup-uninstall" <<'SCRIPTEOF'
#!/bin/bash
# usb-backup-uninstall — Cleanly remove all USB backup components
# Usage: usb-backup-uninstall [--wipe]
set -euo pipefail
SCRIPT_NAME="uninstall"

# Source config if available, fallback to defaults
if [[ -f /etc/usb-backup/config ]]; then
    source /etc/usb-backup/config
else
    MOUNTPOINT="/mnt/usb-backup"
    STORAGE_ID="usb-backup"
    LABEL="pve-backup"
    CONFIG_DIR="/etc/usb-backup"
    LOG_FILE="/var/log/usb-backup.log"
fi

log() { echo "[$(date '+%H:%M:%S')] $1"; echo "$(date '+%Y-%m-%d %H:%M:%S') [UNINSTALL] $1" >> "$LOG_FILE" 2>/dev/null || true; }

[[ $EUID -ne 0 ]] && { echo "Run as root."; exit 1; }

WIPE_DATA=false
[[ "${1:-}" == "--wipe" ]] && WIPE_DATA=true

echo ""
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║            USB Backup Uninstall                            ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo ""
echo "  Will remove:"
echo "    • Proxmox storage '${STORAGE_ID}'"
echo "    • fstab entry for ${MOUNTPOINT}"
echo "    • Companion scripts (usb-backup-mount/unmount/status/verify)"
echo "    • Configuration directory ${CONFIG_DIR}/"
echo "    • Systemd automount/mount units for ${MOUNTPOINT}"
[[ "$WIPE_DATA" == "true" ]] && echo "    • ALL DATA on USB drive (--wipe)"
echo ""
echo "  Will NOT remove:"
echo "    • Log file: ${LOG_FILE}"
echo "    • fstab backups: /etc/fstab.pre-usb-backup-*"
[[ "$WIPE_DATA" == "false" ]] && echo "    • Data on USB drive (use --wipe to include)"
echo ""

read -rp "  Type UNINSTALL to confirm: " CONFIRM
[[ "$CONFIRM" != "UNINSTALL" ]] && { echo "  Aborted."; exit 0; }
echo ""

# 1. Disable and remove Proxmox storage
log "Removing Proxmox storage '${STORAGE_ID}'..."
pvesm set "$STORAGE_ID" --disable 1 2>/dev/null || true
pvesm remove "$STORAGE_ID" 2>/dev/null || true

# 2. Unmount
if findmnt -rn "$MOUNTPOINT" &>/dev/null; then
    log "Unmounting ${MOUNTPOINT}..."
    sync
    umount "$MOUNTPOINT" 2>/dev/null || umount -l "$MOUNTPOINT" 2>/dev/null || true
fi

# 3. Stop automount/mount units
for suffix in automount mount; do
    UNIT=$(systemd-escape --path --suffix="$suffix" "$MOUNTPOINT" 2>/dev/null || true)
    [[ -n "$UNIT" ]] && systemctl stop "$UNIT" 2>/dev/null || true
done

# 4. Clean fstab
log "Removing fstab entry..."
cp /etc/fstab "/etc/fstab.pre-uninstall-$(date +%Y%m%d-%H%M%S)"
sed -i '/# USB backup SSD (pve-backup)/d' /etc/fstab
sed -i "\|${MOUNTPOINT}|d" /etc/fstab
systemctl daemon-reload

# 5. Optional: wipe drive data
if [[ "$WIPE_DATA" == "true" ]]; then
    PART=$(blkid -L "$LABEL" 2>/dev/null || true)
    if [[ -n "$PART" ]]; then
        log "Wiping filesystem signatures on ${PART}..."
        wipefs --all --force "$PART" 2>/dev/null || true
    fi
fi

# 6. Remove companion scripts
log "Removing companion scripts..."
rm -f /usr/local/sbin/usb-backup-mount
rm -f /usr/local/sbin/usb-backup-unmount
rm -f /usr/local/sbin/usb-backup-status
rm -f /usr/local/sbin/usb-backup-verify

# 7. Remove config directory (includes manifests)
log "Removing configuration (${CONFIG_DIR})..."
rm -rf "$CONFIG_DIR"

# 8. Remove mountpoint (only if empty)
rmdir "$MOUNTPOINT" 2>/dev/null || true

log "Uninstall complete."
echo ""
echo "  Remaining (manual cleanup if desired):"
echo "    ${LOG_FILE}"
echo "    /etc/fstab.pre-usb-backup-*"
echo "    /usr/local/sbin/usb-backup-uninstall  (this script)"
echo ""
echo "  To finish:  rm /usr/local/sbin/usb-backup-uninstall"
echo ""
SCRIPTEOF
chmod +x "${SCRIPTS_DIR}/usb-backup-uninstall"

msg "All companion scripts installed."

# ══════════════════════════════════════════════════════════════════════════════
# INITIAL SMART CHECK ON SETUP
# ══════════════════════════════════════════════════════════════════════════════
if [[ -n "$DEVICE" ]] && command -v smartctl &>/dev/null; then
    info "Running initial SMART health check..."
    source "${CONFIG_DIR}/config"
    source "${CONFIG_DIR}/functions"
    SCRIPT_NAME="setup"
    smart_check "$DEVICE" || true
fi

# ══════════════════════════════════════════════════════════════════════════════
# FINAL SUMMARY
# ══════════════════════════════════════════════════════════════════════════════
echo ""
echo -e "${GREEN}╔══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║                    SETUP COMPLETE  (v3)                    ║${NC}"
echo -e "${GREEN}╚══════════════════════════════════════════════════════════════╝${NC}"
echo ""
echo "  Storage ID:    ${STORAGE_ID}"
echo "  Mount point:   ${MOUNTPOINT}"
echo "  Device:        ${DEVICE} → ${PART}"
echo "  UUID:          ${UUID}"
echo "  Label:         ${LABEL}  (LABEL-based fstab for drive rotation)"
echo "  Config:        ${CONFIG_DIR}/"
echo "  fstab backup:  ${FSTAB_BACKUP}"
echo ""
echo "  Current disk:"
df -h "$MOUNTPOINT" | tail -1 | awk '{printf "    %s total, %s available (%s used)\n", $2, $4, $5}'
echo ""
echo -e "${CYAN}  ┌── Commands ──────────────────────────────────────────────────┐${NC}"
echo "  │                                                              │"
echo "  │  usb-backup-mount              Mount + SMART + enable        │"
echo "  │  usb-backup-mount --no-smart   Mount without SMART check     │"
echo "  │  usb-backup-unmount            Manifest + disable + unmount  │"
echo "  │  usb-backup-unmount --eject    + power off for safe removal  │"
echo "  │  usb-backup-unmount --no-manifest  Skip manifest (faster)    │"
echo "  │  usb-backup-status             Full status overview          │"
echo "  │  usb-backup-status --smart     + live SMART check            │"
