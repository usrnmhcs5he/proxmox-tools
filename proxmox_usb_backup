echo "  │  usb-backup-uninstall --wipe   + erase drive data            │"
echo "  │                                                              │"
echo -e "  └────────────────────────────────────────────────────────────────┘${NC}"
echo ""
echo -e "${CYAN}  ┌── Workflow ──────────────────────────────────────────────────┐${NC}"
